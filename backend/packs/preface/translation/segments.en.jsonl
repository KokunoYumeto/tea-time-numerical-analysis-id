{"edition_id":"urn:uuid:35b4350d-7202-5d47-8b85-5262d7ca441c","id":"urn:uuid:a5d82be6-520c-530c-a8a4-b1f295976a08","order":3,"protected_tokens":[{"command_kind":"href","header":"CommandInset href","kind":"CommandInset","ordinal":1,"sha256":"4ce912108f9d51c70e522f458d7066ae8ac3f4ef4cc29af44f87314ac606dc34","target":"https://octave-app.org/"}],"record_type":"segment","rights_id":"urn:uuid:52a7c815-5b13-5f21-a52a-e7fa11238e07","schema_id":"ttna-segment-v1","schema_version":"1.0.0","semantic_slot":"paragraph","source_block_sha256":"9f7a38ef7d46404fa3f95831eb49147d287977d6c4851c32fb41a268e69c08a8","source_file_id":"urn:uuid:271e812b-1ccd-53ed-a402-07fe58709c8a","source_locale":"en-US","source_locator":{"end_line":545,"layout":"Standard","layout_ordinal":24,"start_line":528},"source_text":"For macOS, see {{HREF:1}}. Perhaps the simplest installation method is to follow the link to the wiki page and then use the links under macOS App Bundles. If you use this method, the first time you launch Octave, you will need to control-click the Application icon and select Open from the popup menu. If you simply click-start it like other applications, macOS will disallow it since the application is unsigned and therefore untrusted.","source_text_sha256":"7b3a0ed5214a893b672fb60f5ef964945ac4a12cf4c3d052820266126e2a50d0","translation_state":"source_frozen","unit_id":"urn:uuid:844e0e01-ed7b-5fae-a80a-1a53eb0650e1"}
