{"build_state":"not_built","id":"urn:uuid:da72042b-a8b7-52d1-b1b4-236069a5a095","interchange_state":"structurally_verified","language_state":"draft_translated","locale":"id-ID","math_state":"not_applicable","protected_token_shape_equal":true,"protected_tokens":[],"provenance":"local Codex translation requested by Floris","publication_state":"unpublished","record_type":"localization","schema_id":"ttna-localization-v1","schema_version":"1.0.0","segment_id":"urn:uuid:7b839644-f99b-5d56-96eb-04c4e461dfee","source_segment_sha256":"b1cb90663854ae73ba55caca1441a67e3ff1c942dde98315865e19a2b139f622","structure_state":"structurally_verified","target_block_sha256":"953ff98f319b00e797f43dca37f8086c123ad1c62473631bf703947589ee1f77","target_locator":{"end_line":495,"layout":"Standard","layout_ordinal":19,"start_line":486},"target_path":"translation/lyx-id/preface.lyx","target_text":"Octave Online dirancang khusus sebagai antarmuka Octave dan menyediakan fitur yang berguna untuk pembelajaran di kelas. Ajukan tiket dukungan untuk menanyakan penyiapan suatu kelas. Kode kelas yang dihasilkan memungkinkan pengajar melihat ruang kerja mahasiswa dan berkolaborasi secara waktu nyata setelah mereka mendaftar ke kelas tersebut. Fitur bucket memungkinkan pengajar memasang kode hanya-baca untuk diimpor mahasiswa ke akun mereka, sehingga kode untuk praktikum atau tugas mudah dibagikan.","target_text_sha256":"44e78fe103f4585cd1e69da006a7e2152b02bd6dc3613018fbcf8336f3e11b62","workflow_state":"translated"}
