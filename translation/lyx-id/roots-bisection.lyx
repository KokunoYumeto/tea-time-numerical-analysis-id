\begin_layout Plain Layout

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\end_layout

\begin_layout Plain Layout

function m=bisection(a,b,f,tol)
\end_layout

\begin_layout Plain Layout

  N=ceil((log(b-a)-log(tol))/log(2));
\end_layout

\begin_layout Plain Layout

  L=f(a);
\end_layout

\begin_layout Plain Layout

  for i=1:N
\end_layout

\begin_layout Plain Layout

    m=(a+b)/2;
\end_layout

\begin_layout Plain Layout

    M=f(m);
\end_layout

\begin_layout Plain Layout

    if (M==0)
\end_layout

\begin_layout Plain Layout

      return;
\end_layout

\begin_layout Plain Layout

    end%if
\end_layout

\begin_layout Plain Layout

    if (L*M<0)
\end_layout

\begin_layout Plain Layout

      b=m;
\end_layout

\begin_layout Plain Layout

    else
\end_layout

\begin_layout Plain Layout

      a=m;
\end_layout

\begin_layout Plain Layout

      L=M;
\end_layout

\begin_layout Plain Layout

    end%if
\end_layout

\begin_layout Plain Layout

  end%for
\end_layout

\begin_layout Plain Layout

end%function
\end_layout

\begin_layout Plain Layout


\backslash
