\begin_layout Standard
Salah satu landasan analisis numerik adalah teorema Taylor yang telah Anda
 pelajari dalam Kalkulus.
 Meskipun demikian, ada baiknya kita mengulang pembahasan singkatnya di sini.
\end_layout

\begin_layout Theorem
\begin_inset CommandInset label
LatexCommand label
name "thm:Taylors"

\end_inset


\begin_inset Index idx
status collapsed

\begin_layout Plain Layout
Teorema ! Taylor
\end_layout

\end_inset

Untuk suatu bilangan bulat 
\begin_inset Formula $n\geq0$
\end_inset

, misalkan 
\begin_inset Formula $f(x)$
\end_inset

 memiliki 
\begin_inset Formula $n+1$
\end_inset

 turunan pada 
\begin_inset Formula $(a,b)$
\end_inset

, dan 
\begin_inset Formula $x_{0}\in(a,b)$
\end_inset

.
 Maka, untuk setiap 
\begin_inset Formula $x\in(a,b)$
\end_inset

, terdapat suatu 
\begin_inset Formula $\xi$
\end_inset

 yang bergantung pada 
\begin_inset Formula $x$
\end_inset

 dan terletak di antara 
\begin_inset Formula $x$
\end_inset

 dan 
\begin_inset Formula $x_{0}$
\end_inset

 sedemikian sehingga
\begin_inset Formula 
\[
f(x)=f(x_{0})+\sum_{j=1}^{n}\left(\frac{f^{(j)}(x_{0})}{j!}(x-x_{0})^{j}\right)+\frac{f^{(n+1)}(\xi)}{(n+1)!}(x-x_{0})^{n+1}.
\]

\end_inset


\end_layout

\begin_layout Proof
\noindent
Untuk kasus 
\begin_inset Formula $x=x_{0}$
\end_inset

, klaim tersebut jelas.
 
\begin_inset Formula $\xi=x=x_{0}$
\end_inset

 dapat digunakan.
 Sekarang misalkan 
\begin_inset Formula $x\neq x_{0}$
\end_inset

, dan misalkan 
\begin_inset Formula $I$
\end_inset

 adalah interval terbuka di antara 
\begin_inset Formula $x$
\end_inset

 dan 
\begin_inset Formula $x_{0}$
\end_inset

, serta 
\begin_inset Formula $\overline{I}$
\end_inset

 adalah interval tertutup di antara 
\begin_inset Formula $x$
\end_inset

 dan 
\begin_inset Formula $x_{0}$
\end_inset

.
 Karena 
\begin_inset Formula $I\subset\overline{I}\subset(a,b)$
\end_inset

 dan 
\begin_inset Formula $f$
\end_inset

 memiliki 
\begin_inset Formula $n+1$
\end_inset

 turunan pada 
\begin_inset Formula $(a,b)$
\end_inset

, kita memperoleh bahwa 
\begin_inset Formula $f,f',f'',\ldots,f^{(n)}$
\end_inset

 semuanya kontinu pada 
\begin_inset Formula $\overline{I}$
\end_inset

 dan bahwa 
\begin_inset Formula $f^{(n+1)}$
\end_inset

 terdefinisi pada 
\begin_inset Formula $I$
\end_inset

.
 Sekarang kita definisikan
\begin_inset Formula 
\[
F(z)=f(x)-f(z)-\sum_{j=1}^{n}\frac{f^{(j)}(z)}{j!}(x-z)^{j}
\]

\end_inset

dan kita akan membuktikan teorema dengan menunjukkan bahwa 
\begin_inset Formula $F(x_{0})=\frac{(x-x_{0})^{n+1}}{(n+1)!}f^{(n+1)}(\xi)$
\end_inset

 untuk suatu 
\begin_inset Formula $\xi\in I$
\end_inset

.
 Perhatikan bahwa 
\begin_inset Formula $F'(z)$
\end_inset

, yang merupakan jumlah teleskopik, diberikan oleh
\begin_inset Formula 
\begin{eqnarray*}
F'(z) & = & -f'(z)-\sum_{j=1}^{n}\left[\frac{f^{(j+1)}(z)}{j!}(x-z)^{j}-\frac{f^{(j)}(z)}{(j-1)!}(x-z)^{j-1}\right]\\
 & = & -f'(z)-\left[\frac{f^{(n+1)}(z)}{n!}(x-z)^{n}-f'(z)\right]\\
 & = & -\frac{f^{(n+1)}(z)}{n!}(x-z)^{n}.
\end{eqnarray*}

\end_inset

Sekarang definisikan 
\begin_inset Formula $g(z)=F(z)-\left(\frac{x-z}{x-x_{0}}\right)^{n+1}F(x_{0})$
\end_inset

.
 Mudah diperiksa bahwa 
\begin_inset Formula $g$
\end_inset

 memenuhi hipotesis teorema Rolle.
 Memang, 
\begin_inset Formula $g(x_{0})=g(x)=0$
\end_inset

 dan syarat kekontinuan serta keterdiferensialan terpenuhi.
 Menurut teorema Rolle, terdapat 
\begin_inset Formula $\xi\in I$
\end_inset

 sedemikian sehingga 
\begin_inset Formula $g'(\xi)=0=F'(\xi)+(n+1)\frac{(x-\xi)^{n}}{(x-x_{0})^{n-1}}F(x_{0})$
\end_inset

.
 Dengan demikian, 
\begin_inset Formula 
\begin{eqnarray*}
F(x_{0}) & = & -F'(\xi)\frac{(x-x_{0})^{n+1}}{(n+1)(x-\xi)^{n}}\\
 & = & \frac{f^{(n+1)}(\xi)}{n!(n+1)}(x-x_{0})^{n+1}\\
 & = & \frac{f^{(n+1)}(\xi)}{(n+1)!}(x-x_{0})^{n+1}.
\end{eqnarray*}

\end_inset

Dengan demikian, pembuktian selesai.
 
\end_layout

\begin_layout Standard
Kita akan menggunakan notasi 
\begin_inset Formula 
\[
T_{n}(x)=f(x_{0})+\sum_{j=1}^{n}\left(\frac{f^{(j)}(x_{0})}{j!}(x-x_{0})^{j}\right)
\]

\end_inset

dan menyebutnya polinomial Taylor berorde 
\begin_inset Formula $n$
\end_inset

 
