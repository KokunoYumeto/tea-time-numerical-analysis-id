\end_inset

, jika parabola dipaksa melalui titik 
\begin_inset Formula $(a,A)$
\end_inset

, 
\begin_inset Formula $(b,B)$
\end_inset

, dan 
\begin_inset Formula $(c,C)$
\end_inset

, lalu peran 
\begin_inset Formula $x$
\end_inset

 dan 
\begin_inset Formula $y$
\end_inset

 dipertukarkan, rumus untuk parabola invers 
\begin_inset Formula $q$
\end_inset

 langsung diperoleh:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
q(y)=q_{0}(y-B)^{2}+q_{1}(y-B)+q_{2}
\]

\end_inset

dengan
\begin_inset Formula 
\begin{eqnarray*}
q_{2} & = & b\\
q_{1} & = & \frac{(A-B)^{2}(c-b)-(C-B)^{2}(a-b)}{(A-B)(C-B)(A-C)}\\
q_{0} & = & \frac{(C-B)(a-b)-(A-B)(c-b)}{(A-B)(C-B)(A-C)}.
\end{eqnarray*}

\end_inset


