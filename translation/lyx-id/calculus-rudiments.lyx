\begin_layout Enumerate
Rumus umum tiga titik untuk turunan pertama yang menggunakan 
\begin_inset Formula $f(x_{0})$
\end_inset

, 
\begin_inset Formula $f(x_{0}+\alpha h)$
\end_inset

, dan 
\begin_inset Formula $f(x_{0}+2h)$
\end_inset

, dengan 
\begin_inset Formula $\alpha\neq0$
\end_inset

 dan 
\begin_inset Formula $\alpha\neq2$
\end_inset

, diberikan oleh
\begin_inset Formula 
\begin{eqnarray*}
f'(x_{0}) & = & \frac{1}{2h}\left[-\frac{2+\alpha}{\alpha}f(x_{0})\right.\\
 &  & \qquad+\frac{4}{\alpha(2-\alpha)}f(x_{0}+\alpha h)\\
 &  & \qquad\left.-\frac{\alpha}{2-\alpha}f(x_{0}+2h)\right]+O(h^{2})
\end{eqnarray*}

\end_inset


\begin_inset Separator latexpar
\end_inset


\end_layout

\begin_deeper
\begin_layout Standard
Gunakan ekspansi Taylor dari 
\begin_inset Formula $f(x_{0}+\alpha h)$
\end_inset

 dan 
\begin_inset Formula $f(x_{0}+2h)$
\end_inset

 untuk menurunkan rumus yang diberikan.
\end_layout

\end_deeper
