\end_layout

\begin_layout LyX-Code
  sprintf('%12.5g%12.5g%12.5g%12.5g%12.5g',euler,trap,x,abs(euler-x),abs(trap-x))
\end_layout

\begin_layout LyX-Code
end%for
\end_layout

