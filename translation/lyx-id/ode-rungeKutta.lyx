\begin_layout LyX-Code
trap=20;
\end_layout

\begin_layout LyX-Code
disp('             Euler   Trapezoid       Exact   Euler err    Trap err')
\end_layout

\begin_layout LyX-Code
disp('        -------------------------------------------------------------')
\end_layout

\begin_layout LyX-Code
for i=1:8
\end_layout

\begin_layout LyX-Code
  euler=euler+h*f(t,euler);
\end_layout

\begin_layout LyX-Code
  k1=f(t,trap);
\end_layout

\begin_layout LyX-Code
  k2=f(t+h,trap+h*k1);
\end_layout

\begin_layout LyX-Code
