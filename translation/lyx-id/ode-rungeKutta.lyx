.
 Suku galat untuk
\family default
\series default
\shape default
\size default
\emph default
\bar default
\strikeout default
\uuline default
\uwave default
\noun default
\color inherit

\begin_inset Formula 
\[
\int_{x_{0}}^{x_{0}+h}f(x)dx\approx hf(x_{0})
\]

\end_inset

diturunkan dengan cara serupa.
 Diketahui bahwa galatnya adalah 
\begin_inset Formula $O(h^{2})$
\end_inset

, sehingga kita dapat melewati proses penurunannya.
 Dengan mengembangkan 
\begin_inset Formula $f(x)$
\end_inset

 dalam polinomial Taylor dengan suku galat,
\begin_inset Formula 
\[
f(x)=f(x_{0})+(x-x_{0})f'(\xi_{x}).
\]

\end_inset

Dengan demikian,
\begin_inset Formula 
\begin{eqnarray*}
\int_{x_{0}}^{x_{0}+h}f(x)dx-hf(x_{0}) & = & \int_{x_{0}}^{x_{0}+h}\left(f(x_{0})+(x-x_{0})f'(\xi_{x})\right)dx-hf(x_{0})\\
 & = & \left.xf(x_{0})\right|_{x_{0}}^{x_{0}+h}+\int_{x_{0}}^{x_{0}+h}(x-x_{0})f'(\xi_{x})dx-hf(x_{0})\\
 & = & hf(x_{0})+\int_{x_{0}}^{x_{0}+h}(x-x_{0})f'(\xi_{x})dx-hf(x_{0})\\
 & = & \int_{x_{0}}^{x_{0}+h}(x-x_{0})f'(\xi_{x})dx.
\end{eqnarray*}

\end_inset

Menurut Teorema Nilai Rata-Rata Berbobot, terdapat 
\begin_inset Formula $c\in(x_{0},x_{0}+h)$
\end_inset

 sedemikian sehingga 
\begin_inset Formula $\int_{x_{0}}^{x_{0}+h}(x-x_{0})f'(\xi_{x})dx=f'(c)\int_{x_{0}}^{x_{0}+h}(x-x_{0})dx=\frac{1}{2}f'(c)h^{2}$
\end_inset

.
 Oleh karena itu, 
\begin_inset Formula 
\[
\int_{x_{0}}^{x_{0}+h}f(x)dx-hf(x_{0})=\frac{1}{2}f'(c)h^{2}\leq Mh^{2}f'(\xi_{h})
\]

\end_inset

dengan mengganti 
\begin_inset Formula $c$
\end_inset

 dengan 
\begin_inset Formula $\xi_{h}$
\end_inset

.
 
\end_layout

