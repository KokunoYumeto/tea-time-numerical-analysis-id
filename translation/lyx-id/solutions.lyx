\begin_inset Formula $O(h^{4}f^{(6)}(\xi_{h}))$
\end_inset

, sehingga 
\begin_inset Formula $E_{.1}=k(.1)^{3}f^{(5)}(\xi_{.1})$
\end_inset

 atau 
\begin_inset Formula $E_{.1}=k(.1)^{4}f^{(6)}(\xi_{.1})$
\end_inset

 dan 
\begin_inset Formula $E_{.02}=k(.02)^{3}f^{(5)}(\xi_{.02})$
\end_inset

 atau 
\begin_inset Formula $E_{.02}=k(.02)^{4}f^{(6)}(\xi_{.02})$
\end_inset

.
 Dengan mengasumsikan 
\begin_inset Formula $f^{(5)}(\xi_{.1})\approx f^{(5)}(\xi_{.02})$
\end_inset

 jika suku galatnya adalah 
\begin_inset Formula $O(h^{3}f^{(5)}(\xi_{h}))$
\end_inset

 atau bahwa 
\begin_inset Formula $f^{(6)}(\xi_{.1})\approx f^{(6)}(\xi_{.02})$
\end_inset

 jika suku galatnya adalah 
\begin_inset Formula $O(h^{4}f^{(6)}(\xi_{h}))$
\end_inset

, kita memperkirakan
\begin_inset Formula 
\[
\frac{E_{.1}}{E_{.02}}=\frac{k(.1)^{3}f^{(5)}(\xi_{.1})}{k(.02)^{3}f^{(5)}(\xi_{.02})}\approx\left(\frac{.1}{.02}\right)^{3}=125
\]

\end_inset

atau 
\begin_inset Formula 
\[
\frac{E_{.1}}{E_{.02}}=\frac{k(.1)^{4}f^{(6)}(\xi_{.1})}{k(.02)^{4}f^{(6)}(\xi_{.02})}\approx\left(\frac{.1}{.02}\right)^{4}=625.
\]

\end_inset


\end_layout

