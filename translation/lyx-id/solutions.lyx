\begin_layout LyX-Code
function [y,x] = eulerode(f,a,ya,b,n)
\end_layout

\begin_layout LyX-Code
  i = 1;
\end_layout

\begin_layout LyX-Code
  x(i) = a;
\end_layout

\begin_layout LyX-Code
  y(i) = ya;
\end_layout

\begin_layout LyX-Code
  h = (b-a)/n;
\end_layout

\begin_layout LyX-Code
  while (i<=n)
\end_layout

\begin_layout LyX-Code
    y(i+1) = y(i) + h*f(x(i),y(i));
\end_layout

\begin_layout LyX-Code
    x(i+1) = a + (b-a)*i/n;
\end_layout

\begin_layout LyX-Code
    i = i+1;
\end_layout

\begin_layout LyX-Code
  end%while
\end_layout

\begin_layout LyX-Code
end%function 
