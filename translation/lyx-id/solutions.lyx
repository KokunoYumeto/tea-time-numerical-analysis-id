\begin_layout Enumerate
Sebuah perulangan tambahan akan ditambahkan agar kode menghampiri 
\begin_inset Formula $y(2)$
\end_inset

 untuk sejumlah ukuran langkah.
\end_layout

\begin_layout Standard
Modifikasi ini memudahkan kita menentukan laju
 kekonvergenan.
\end_layout

\begin_layout LyX-Code
t0=4;
\end_layout

\begin_layout LyX-Code
h=-1/4;
\end_layout

\begin_layout LyX-Code
n=8;
\end_layout

\begin_layout LyX-Code
f=@(t,y) -y/t+t^2;
\end_layout

\begin_layout LyX-Code
exact=@(t) t^3/4+16/t;
\end_layout

\begin_layout LyX-Code
y0=20;
\end_layout

\begin_layout LyX-Code
disp('                 h           y       Error')
\end_layout

\begin_layout LyX-Code
disp('      ------------------------------------')
\end_layout

\begin_layout LyX-Code
for j=1:6
\end_layout

\begin_layout LyX-Code
  t=t0;
\end_layout

\begin_layout LyX-Code
  y=y0;
\end_layout

\begin_layout LyX-Code
  for i=1:n
\end_layout

\begin_layout LyX-Code
    k1=f(t,y);
\end_layout

\begin_layout LyX-Code
    k2=f(t+2*h/3,y+2*h/3*k1);
\end_layout

\begin_layout LyX-Code
    y=y+h/4*(k1+3*k2);
\end_layout

\begin_layout LyX-Code
    t=t+h;
\end_layout

\begin_layout LyX-Code
  end%for
\end_layout

\begin_layout LyX-Code
  x=exact(t);
\end_layout

\begin_layout LyX-Code
  sprintf('%12.5g%12.5g%12.5g',h,y,abs(y-x))
\end_layout

\begin_layout LyX-Code
  n=n*2;
\end_layout

\begin_layout LyX-Code
  h=h/2;
\end_layout

\begin_layout LyX-Code
end%for
\end_layout

