Aturan Trapesium komposit ! kode
\end_layout

\end_inset


\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
begin{verbatim}
\end_layout

\begin_layout Plain Layout

####################################################
\end_layout

\begin_layout Plain Layout

# Written by Dr.
 Len Brin           2 April 2012   #
\end_layout

\begin_layout Plain Layout

# MAT 322 Numerical Analysis I                     #
\end_layout

\begin_layout Plain Layout

# Purpose: Implementation of composite Trapezoidal #
\end_layout

\begin_layout Plain Layout

# rule                                             #
\end_layout

\begin_layout Plain Layout

# INPUT: function f, interval endpoints a and b,   #
\end_layout

\begin_layout Plain Layout

#        number of subintervals n                  #
\end_layout

\begin_layout Plain Layout

# OUTPUT: approximate integral of f(x) from a to b #
\end_layout

\begin_layout Plain Layout

####################################################
\end_layout

\begin_layout Plain Layout

function integral = compositeTrapezoidal(f,a,b,n)
\end_layout

\begin_layout Plain Layout

  h = (b-a)/n;
\end_layout

\begin_layout Plain Layout

  s = 0;
\end_layout

\begin_layout Plain Layout

  for i = 1:n-1
\end_layout

\begin_layout Plain Layout

    s = s + f(a+i*h);
\end_layout

\begin_layout Plain Layout

  end#for
\end_layout

\begin_layout Plain Layout

  integral = h*(f(a)+2*s+f(b))/2;
\end_layout

\begin_layout Plain Layout

end#function
\end_layout

\begin_layout Plain Layout


\backslash
end{verbatim}
\end_layout

\end_inset

untuk menghitung 
\begin_inset Formula $T_{10}(0,1)$
\end_inset

:
