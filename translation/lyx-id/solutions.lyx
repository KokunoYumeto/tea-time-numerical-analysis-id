\begin_layout LyX-Code
% INPUT: function f(x,y); interval [a,b]; y(a); steps n          %
\end_layout

\begin_layout LyX-Code
% OUTPUT: approximation (x(i),y(i)) of the solution of y'=f(x,y) %
\end_layout

\begin_layout LyX-Code
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
