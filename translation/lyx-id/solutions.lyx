\begin_layout Description
\begin_inset CommandInset ref
LatexCommand ref
reference "exc:cubicSplines-9"

\end_inset

: Pertama, deklarasi fungsi harus diubah.
 Turunan di titik ujung kiri dan kanan, 
\begin_inset Formula $m_{0}$
\end_inset

 dan 
\begin_inset Formula $m_{n}$
\end_inset

, akan ditentukan, sehingga fungsi tersebut memerlukan argumen tambahan.
 Selain itu, nama fungsi perlu diubah:
\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
begin{verbatim}
\end_layout

\begin_layout Plain Layout

function [a,b,c,d] = naturalCubicSpline(x,y)
\end_layout

\begin_layout Plain Layout


\backslash
end{verbatim}
\end_layout

\end_inset

harus menjadi
\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
begin{verbatim}
\end_layout

\begin_layout Plain Layout

function [a,b,c,d] = clampedCubicSpline(x,y,m0,mn)
\end_layout

\begin_layout Plain Layout


\backslash
end{verbatim}
\end_layout

\end_inset

Modifikasi selanjutnya melibatkan syarat titik ujung dan pengaruhnya
 terhadap persamaan di dalam fungsi.
 Kita mulai dengan menyelesaikan kondisi titik ujung kiri untuk 
\begin_inset Formula $d_{1}$
\end_inset

: 
\begin_inset Formula $b_{1}+2c_{1}h_{1}+3d_{1}h_{1}^{2}=m_{0}\Rightarrow$
\end_inset


\begin_inset Formula 
\begin{equation}
d_{1}=\frac{m_{0}-b_{1}-2c_{1}h_{1}}{3h_{1}^{2}}.\label{eq:d1}
\end{equation}

\end_inset

Dengan menyubstitusikan persamaan ini, 
\begin_inset Formula $a_{i}=y_{i}$
\end_inset

, serta persamaan 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:b1"

\end_inset

 ke dalam 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:interpolationRequirement"

\end_inset

 dengan 
\begin_inset Formula $i=1$
\end_inset

 diperoleh 
\begin_inset Formula 
\[
y_{1}+\left(\frac{y_{1}-y_{2}}{h_{2}}+\frac{2}{3}h_{2}c_{1}+\frac{1}{3}h_{2}c_{2}\right)h_{1}+c_{1}h_{1}^{2}+\frac{m_{0}-\left(\frac{y_{1}-y_{2}}{h_{2}}+\frac{2}{3}h_{2}c_{1}+\frac{1}{3}h_{2}c_{2}\right)-2c_{1}h_{1}}{3h_{1}^{2}}h_{1}^{3}=y_{0},
\]

\end_inset

yang disederhanakan sebagai berikut.
\begin_inset Formula 
\begin{eqnarray*}
\left(\frac{y_{1}-y_{2}}{h_{2}}+\frac{2}{3}h_{2}c_{1}+\frac{1}{3}h_{2}c_{2}\right)h_{1}+c_{1}h_{1}^{2}+\frac{m_{0}-\left(\frac{y_{1}-y_{2}}{h_{2}}+\frac{2}{3}h_{2}c_{1}+\frac{1}{3}h_{2}c_{2}\right)-2c_{1}h_{1}}{3}h_{1} & = & y_{0}-y_{1}\\
\frac{y_{1}-y_{2}}{h_{2}}+\frac{2}{3}h_{2}c_{1}+\frac{1}{3}h_{2}c_{2}+c_{1}h_{1}+\frac{m_{0}-\left(\frac{y_{1}-y_{2}}{h_{2}}+\frac{2}{3}h_{2}c_{1}+\frac{1}{3}h_{2}c_{2}\right)-2c_{1}h_{1}}{3} & = & \frac{y_{0}-y_{1}}{h_{1}}\\
3\frac{y_{1}-y_{2}}{h_{2}}+2h_{2}c_{1}+h_{2}c_{2}+3c_{1}h_{1}+m_{0}-\left(\frac{y_{1}-y_{2}}{h_{2}}+\frac{2}{3}h_{2}c_{1}+\frac{1}{3}h_{2}c_{2}\right)+-2c_{1}h_{1} & = & 3\frac{y_{0}-y_{1}}{h_{1}}\\
2\frac{y_{1}-y_{2}}{h_{2}}+2h_{2}c_{1}+h_{2}c_{2}+c_{1}h_{1}+m_{0}-\left(\frac{2}{3}h_{2}c_{1}+\frac{1}{3}h_{2}c_{2}\right) & = & 3\frac{y_{0}-y_{1}}{h_{1}}\\
6\frac{y_{1}-y_{2}}{h_{2}}+6h_{2}c_{1}+3h_{2}c_{2}+3c_{1}h_{1}+3m_{0}-\left(2h_{2}c_{1}+h_{2}c_{2}\right) & = & 9\frac{y_{0}-y_{1}}{h_{1}}\\
6\frac{y_{1}-y_{2}}{h_{2}}+4h_{2}c_{1}+2h_{2}c_{2}+3c_{1}h_{1}+3m_{0} & = & 9\frac{y_{0}-y_{1}}{h_{1}},
\end{eqnarray*}

\end_inset

dan akhirnya 
\begin_inset Formula 
\begin{equation}
\left(4h_{2}+3h_{1}\right)c_{1}+2h_{2}c_{2}=9\frac{y_{0}-y_{1}}{h_{1}}-6\frac{y_{1}-y_{2}}{h_{2}}-3m_{0}.\label{eq:firstC}
\end{equation}

\end_inset

Kondisi titik ujung kanan, 
\begin_inset Formula $S_{n}'(x_{n})=m_{n}$
\end_inset

 memberikan 
\begin_inset Formula $b_{n}=m_{n}$
\end_inset

.
 Dengan menyubstitusikan informasi ini ke dalam 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:bi"

\end_inset

 dengan 
\begin_inset Formula $i=n$
\end_inset

 diperoleh 
\begin_inset Formula $m_{n}=\frac{y_{n-1}-y_{n}}{h_{n}}-\frac{(c_{n-1}+2c_{n})h_{n}}{3}$
\end_inset

, yang disederhanakan menjadi
\begin_inset Formula 
\begin{equation}
h_{n}c_{n-1}+2h_{n}c_{n}=3\left(\frac{y_{n-1}-y_{n}}{h_{n}}-m_{n}\right).\label{eq:secondC}
\end{equation}

\end_inset

Persamaan 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:firstC"

\end_inset

 harus diterapkan dalam kode yang dimodifikasi pada baris 21 dan 22: 
\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
begin{verbatim}
\end_layout

\begin_layout Plain Layout

  m(1,1)=2*(h(1)+h(2)); m(1,2)=h(2);
\end_layout

\begin_layout Plain Layout

  m(1,n+1)=3*((y(1)-y(2))/h(1)-(y(2)-y(3))/h(2)); 
\end_layout

\begin_layout Plain Layout


\backslash
end{verbatim}
\end_layout

\end_inset

menjadi
\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
begin{verbatim}
\end_layout

\begin_layout Plain Layout

  m(1,1)=3*h(1)+4*h(2); m(1,2)=2*h(2);
\end_layout

\begin_layout Plain Layout

  m(1,n+1)=9*(y(1)-y(2))/h(1)-6*(y(2)-y(3))/h(2)-3*m0; 
\end_layout

\begin_layout Plain Layout


\backslash
end{verbatim}
\end_layout

\end_inset

 Persamaan 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:secondC"

\end_inset

 harus diterapkan dalam kode yang dimodifikasi pada baris 25:
\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
begin{verbatim}
\end_layout

\begin_layout Plain Layout

  m(n,n-1)=0; m(n,n)=1; m(n,n+1)=0;
\end_layout

\begin_layout Plain Layout


\backslash
end{verbatim}
\end_layout

\end_inset

menjadi
\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
begin{verbatim}
\end_layout

\begin_layout Plain Layout

  m(n,n-1)=h(n); m(n,n)=2*h(n); m(n,n+1)=3*((y(n)-y(n+1))/h(n)-mn);
\end_layout

\begin_layout Plain Layout


\backslash
end{verbatim}
\end_layout

\end_inset

 Penyelesaian untuk nilai 
\begin_inset Formula $c_{i}$
\end_inset

 tetap tidak berubah.
 Kita hanya perlu memodifikasi perhitungan 
\begin_inset Formula $b_{1}$
\end_inset

 dan 
\begin_inset Formula $d_{1}$
\end_inset

 pada baris 47 dan 48.
 
\begin_inset Formula $b_{1}$
\end_inset

 kini berasal dari 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:b1"

\end_inset

, sehingga 
\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
begin{verbatim}
\end_layout

\begin_layout Plain Layout

  b(1)=(y(1)-y(2))/h(1)-2*c(1)*h(1)/3;
\end_layout

\begin_layout Plain Layout


\backslash
end{verbatim}
\end_layout

\end_inset

menjadi
\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
begin{verbatim}
\end_layout

\begin_layout Plain Layout

  b(1)=(y(2)-y(3))/h(2)+2*c(1)*h(2)/3+h(2)*c(2)/3;
\end_layout

\begin_layout Plain Layout


\backslash
end{verbatim}
\end_layout

\end_inset


\begin_inset Formula $d_{1}$
\end_inset

 kini berasal dari 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:d1"

\end_inset

, sehingga
\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
begin{verbatim}
\end_layout

\begin_layout Plain Layout

  d(1)=-c(1)/(3*h(1));
\end_layout

\begin_layout Plain Layout


\backslash
end{verbatim}
\end_layout

\end_inset

menjadi
\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
begin{verbatim}
\end_layout

\begin_layout Plain Layout

  d(1)=(m0-b(1)-2*c(1)*h(1))/(3*h(1)^2);
\end_layout

\begin_layout Plain Layout


\backslash
end{verbatim}
\end_layout

\end_inset

Tentu saja, komentar pada awal fungsi juga harus
 diperbarui.
 Dengan demikian, kode yang dimodifikasi akan tampak kira-kira seperti ini:
\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
begin{verbatim}
\end_layout

\begin_layout Plain Layout

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\end_layout

\begin_layout Plain Layout

% Written by Dr.
 Len Brin           3 June 2014 %
\end_layout

\begin_layout Plain Layout

% Purpose: Calculation of a natural cubic       %
\end_layout

\begin_layout Plain Layout

%        spline.
                                %
\end_layout

\begin_layout Plain Layout

% INPUT: points (x(1),y(1)), (x(2),y(2)), ...
   %
\end_layout

\begin_layout Plain Layout

%        spline must interpolate; first         %
\end_layout

\begin_layout Plain Layout

%        derivative at left endpoint, m0; first %
\end_layout

\begin_layout Plain Layout

%        derivative at right endpoint, mn.
      %
\end_layout

\begin_layout Plain Layout

% OUTPUT: coefficients of each piece of the     %
\end_layout

\begin_layout Plain Layout

%        piecewise cubic spline:                %
\end_layout

\begin_layout Plain Layout

%        S(i,x) = a(i)                          %
\end_layout

\begin_layout Plain Layout

%          + b(i)*(x-x(i+1))                    %
\end_layout

\begin_layout Plain Layout

%          + c(i)*(x-x(i+1))^2                  %
\end_layout

\begin_layout Plain Layout

%          + d(i)*(x-x(i+1))^3                  %
\end_layout

\begin_layout Plain Layout

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\end_layout

\begin_layout Plain Layout

function [a,b,c,d] = clampedCubicSpline(x,y,m0,mn)
\end_layout

\begin_layout Plain Layout

  n=length(x)-1;
\end_layout

\begin_layout Plain Layout

  for i=1:n
\end_layout

\begin_layout Plain Layout

    h(i)=x(i)-x(i+1);
\end_layout

\begin_layout Plain Layout

  end%for
\end_layout

\begin_layout Plain Layout

  % Left endpoint condition:
\end_layout

\begin_layout Plain Layout

  % m(1,1)*c(1) + m(1,2)*c(2) = m(1,n+1)
\end_layout

\begin_layout Plain Layout

  m(1,1)=3*h(1)+4*h(2); m(1,2)=2*h(2);
\end_layout

\begin_layout Plain Layout

  m(1,n+1)=9*(y(1)-y(2))/h(1)-6*(y(2)-y(3))/h(2)-3*m0;
\end_layout

\begin_layout Plain Layout

  % Right endpoint condition:
\end_layout

\begin_layout Plain Layout

  % m(n,n-1)*c(n-1) + m(n,n)*c(n) = m(n,n+1)
\end_layout

\begin_layout Plain Layout

  m(n,n-1)=h(n); m(n,n)=2*h(n); m(n,n+1)=3*((y(n)-y(n+1))/h(n)-mn);
\end_layout

\begin_layout Plain Layout

  % Conditions for all splines:
\end_layout

\begin_layout Plain Layout

  for i=2:n-1
\end_layout

\begin_layout Plain Layout

    m(i,i-1)=h(i);
\end_layout

\begin_layout Plain Layout

    m(i,i)=2*(h(i)+h(i+1));
\end_layout

\begin_layout Plain Layout

    m(i,i+1)=h(i+1);
\end_layout

\begin_layout Plain Layout

    m(i,n+1)=3*((y(i)-y(i+1))/h(i)-(y(i+1)-y(i+2))/h(i+1));
\end_layout

\begin_layout Plain Layout

  end%for
\end_layout

\begin_layout Plain Layout

  % Solve for c(i)
\end_layout

\begin_layout Plain Layout

  l(1)=m(1,1); u(1)=m(1,2)/l(1); z(1)=m(1,n+1)/l(1);
\end_layout

\begin_layout Plain Layout

  for i=2:n-1
\end_layout

\begin_layout Plain Layout

    l(i)=m(i,i)-m(i,i-1)*u(i-1);
\end_layout

\begin_layout Plain Layout

    u(i)=m(i,i+1)/l(i);
\end_layout

\begin_layout Plain Layout

    z(i)=(m(i,n+1)-m(i,i-1)*z(i-1))/l(i);
\end_layout

\begin_layout Plain Layout

  end%for
\end_layout

\begin_layout Plain Layout

  l(n)=m(n,n)-m(n,n-1)*u(n-1);
\end_layout

\begin_layout Plain Layout

  c(n)=(m(n,n+1)-m(n,n-1)*z(n-1))/l(n);
\end_layout

\begin_layout Plain Layout

  for i=n-1:-1:1
\end_layout

\begin_layout Plain Layout

    c(i)=z(i)-u(i)*c(i+1);
\end_layout

\begin_layout Plain Layout

  end%for
\end_layout

\begin_layout Plain Layout

  % Compute a(i), b(i), d(i)
\end_layout

\begin_layout Plain Layout

  % Endpoint conditions:
\end_layout

\begin_layout Plain Layout

  b(1)=(y(2)-y(3))/h(2)+2*c(1)*h(2)/3+h(2)*c(2)/3;
\end_layout

\begin_layout Plain Layout

  d(1)=(m0-b(1)-2*c(1)*h(1))/(3*h(1)^2);
\end_layout

\begin_layout Plain Layout

  % Conditions for all splines:
\end_layout

\begin_layout Plain Layout

  a(1)=y(2);
\end_layout

\begin_layout Plain Layout

  for i=2:n
\end_layout

\begin_layout Plain Layout

    d(i)=(c(i-1)-c(i))/(3*h(i));
\end_layout

\begin_layout Plain Layout

    b(i)=(y(i)-y(i+1))/h(i)-(c(i-1)+2*c(i))*h(i)/3;
\end_layout

\begin_layout Plain Layout

    a(i)=y(i+1);
\end_layout

\begin_layout Plain Layout

  end%for
\end_layout

\begin_layout Plain Layout

  b(n)=mn;
\end_layout

\begin_layout Plain Layout

end%function
\end_layout

\begin_layout Plain Layout


\backslash
