.
 Kita menyelesaikan sistem 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:systemGenericDerivative"

\end_inset

 untuk melakukannya.
 Stensil pada soal ini memiliki 4 simpul, 
\begin_inset Formula $x_{0}$
\end_inset

, 
\begin_inset Formula $x_{0}+h$
\end_inset

, 
\begin_inset Formula $x_{0}+\frac{3}{2}h$
\end_inset

, dan 
\begin_inset Formula $x_{0}+2h$
\end_inset

 dengan titik evaluasi 
\begin_inset Formula $x_{0}+\frac{1}{2}h$
\end_inset

, sehingga dalam sistem 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:systemGenericDerivative"

\end_inset

 kita memiliki 
\begin_inset Formula $n=3$
\end_inset

, 
\begin_inset Formula $\theta_{0}=0$
\end_inset

, 
\begin_inset Formula $\theta_{1}=1$
\end_inset

, 
\begin_inset Formula $\theta_{2}=\frac{3}{2}$
\end_inset

, 
\begin_inset Formula $\theta_{3}=2$
\end_inset

, dan 
\begin_inset Formula $\theta=\frac{1}{2}$
\end_inset

.
 Karena kita sedang menurunkan rumus turunan pertama, kita juga memiliki 
\begin_inset Formula $k=1$
\end_inset

.
 Oleh karena itu, sistem yang perlu kita selesaikan adalah 
\begin_inset Formula 
\begin{eqnarray*}
p_{0}'\left(x_{0}+\frac{1}{2}h\right) & = & a_{0}p_{0}(x_{0})+a_{1}p_{0}(x_{0}+h)+a_{2}p_{0}(x_{0}+\frac{3}{2}h)+a_{3}p_{0}(x_{0}+2h)\\
p_{1}'\left(x_{0}+\frac{1}{2}h\right) & = & a_{0}p_{1}(x_{0})+a_{1}p_{1}(x_{0}+h)+a_{2}p_{1}(x_{0}+\frac{3}{2}h)+a_{3}p_{1}(x_{0}+2h)\\
p_{2}'\left(x_{0}+\frac{1}{2}h\right) & = & a_{0}p_{2}(x_{0})+a_{1}p_{2}(x_{0}+h)+a_{2}p_{2}(x_{0}+\frac{3}{2}h)+a_{3}p_{2}(x_{0}+2h)\\
p_{3}'\left(x_{0}+\frac{1}{2}h\right) & = & a_{0}p_{2}(x_{0})+a_{1}p_{2}(x_{0}+h)+a_{2}p_{2}(x_{0}+\frac{3}{2}h)+a_{3}p_{2}(x_{0}+2h)
\end{eqnarray*}

\end_inset

Sekarang, 
\begin_inset Formula $p_{0}(x)=1$
\end_inset

 sehingga 
\begin_inset Formula $p_{0}'(x_{0}+\frac{1}{2}h)=0;$
\end_inset

 
\begin_inset Formula $p_{1}(x)=x-x_{0}$
\end_inset

 sehingga 
\begin_inset Formula $p_{1}'(x_{0}+\frac{1}{2}h)=1$
\end_inset

; 
\begin_inset Formula $p_{2}(x)=(x-x_{0})^{2}$
\end_inset

 sehingga 
\begin_inset Formula $p_{2}'(x_{0}+\frac{1}{2}h)=h$
\end_inset

; dan 
\begin_inset Formula $p_{3}(x)=(x-x_{0})^{3}$
\end_inset

 sehingga 
\begin_inset Formula $p_{3}'(x_{0}+\frac{1}{2}h)=\frac{3}{4}h^{2}$
\end_inset

.
 Dengan menyubstitusikan informasi ini ke dalam sistem,
\begin_inset Formula 
\begin{eqnarray*}
0 & = & a_{0}+a_{1}+a_{2}+a_{3}\\
1 & = & a_{1}h+a_{2}\cdot\frac{3}{2}h+a_{3}\cdot2h\\
h & = & a_{1}h^{2}+a_{2}\cdot\frac{9}{4}h^{2}+a_{3}\cdot4h\\
\frac{3}{4}h^{2} & = & a_{1}h^{3}+a_{2}\cdot\frac{27}{8}h^{3}+a_{3}\cdot8h.
\end{eqnarray*}

\end_inset

Persamaan pertama adalah satu-satunya persamaan yang memuat 
\begin_inset Formula $a_{0}$
\end_inset

, sehingga kita berfokus menyelesaikan tiga persamaan terakhir, yang dapat disederhanakan
 menjadi:
\begin_inset Formula 
\begin{eqnarray*}
\frac{2}{h} & = & 2a_{1}+3a_{2}+4a_{3}\\
\frac{4}{h} & = & 4a_{1}+9a_{2}+16a_{3}\\
\frac{6}{h} & = & 8a_{1}+27a_{2}+64a_{3}.
\end{eqnarray*}

\end_inset

Dari persamaan pertama, 
\begin_inset Formula $2a_{1}=\frac{2}{h}-3a_{2}-4a_{3}$
\end_inset

 sehingga 
\begin_inset Formula $4a_{1}=\frac{4}{h}-6a_{2}-8a_{3}$
\end_inset

 dan 
\begin_inset Formula $8a_{1}=\frac{8}{h}-12a_{2}-16a_{3}$
\end_inset

.
 Dengan menyubstitusikannya masing-masing ke persamaan kedua dan ketiga,
\begin_inset Formula 
\begin{eqnarray*}
\frac{4}{h} & = & \frac{4}{h}-6a_{2}-8a_{3}+9a_{2}+16a_{3}\\
\frac{6}{h} & = & \frac{8}{h}-12a_{2}-16a_{3}+27a_{2}+64a_{3}
\end{eqnarray*}

\end_inset

yang dapat disederhanakan menjadi
\begin_inset Formula 
\begin{eqnarray*}
0 & = & 3a_{2}+8a_{3}\\
-\frac{2}{h} & = & 15a_{2}+48a_{3}.
\end{eqnarray*}

\end_inset

Dari persamaan pertama, 
\begin_inset Formula $a_{3}=-\frac{3}{8}a_{2}$
\end_inset

.
 Dengan menyubstitusikannya ke persamaan terakhir, 
\begin_inset Formula $-\frac{2}{h}=15a_{2}+48(-\frac{3}{8}a_{2})$
\end_inset

, yang dapat disederhanakan menjadi 
\begin_inset Formula $-\frac{2}{h}=-3a_{2}$
\end_inset

 sehingga 
\begin_inset Formula 
\[
a_{2}=\frac{2}{3h}.
\]

\end_inset

Dengan substitusi balik, 
\begin_inset Formula $a_{3}=-\frac{3}{8}a_{2}=-\frac{3}{8}(\frac{2}{3h})$
\end_inset

 sehingga
\begin_inset Formula 
\[
a_{3}=-\frac{1}{4h}.
\]

\end_inset

Dengan melanjutkan substitusi balik, 
\begin_inset Formula $2a_{1}=\frac{2}{h}-3a_{2}-4a_{3}=\frac{2}{h}-3(\frac{2}{3h})-4(-\frac{1}{4h})$
\end_inset

, yang dapat disederhanakan menjadi 
\begin_inset Formula $2a_{1}=\frac{1}{h}$
\end_inset

 sehingga
\begin_inset Formula 
\[
a_{1}=\frac{1}{2h}.
\]

\end_inset

Terakhir, 
\begin_inset Formula $a_{0}=-a_{1}-a_{2}-a_{3}=-\frac{1}{2h}-\frac{2}{3h}+\frac{1}{4h}$
\end_inset

 sehingga
\begin_inset Formula 
\[
a_{0}=-\frac{11}{12h}.
\]

\end_inset

Dengan demikian, hampiran kita, yaitu rumus 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:derivApprox"

\end_inset

, menjadi
\begin_inset Formula 
\begin{eqnarray*}
f'\left(x_{0}+\frac{1}{2}h\right) & \approx & \frac{11}{12h}f(x_{0})+\frac{1}{2h}f(x_{0}+h)+\frac{2}{3h}f(x_{0}+\frac{3}{2}h)-\frac{1}{4h}f(x_{0}+2h)\\
 & = & \frac{-11f(x_{0})+6f(x_{0}+h)+8f(x_{0}+\frac{3}{2}h)-3f(x_{0}+2h)}{12h}.
\end{eqnarray*}

\end_inset


\end_layout

