P_{0,5}(x) & = & -6+1.05170x+.5725x(x-.1)+.215x(x-.1)(x-.3)\\
 &  & \qquad+.06302x(x-.1)(x-.3)(x-.6)+.01484x(x-.1)(x-.3)(x-.6)(x-1).
\end{eqnarray*}

