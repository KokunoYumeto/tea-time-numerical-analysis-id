\begin_layout Standard
\noindent
\align left
Oleh karena itu, salah satu kemungkinan bentuk Newton adalah
\begin_inset Formula 
\[
N_{2}(x)=f(x_{0})+\frac{f(x_{0}+h)-f(x_{0})}{h}(x-x_{0})+\frac{f(x_{0}+2h)-2f(x_{0}+h)+f(x_{0})}{2h^{2}}(x-x_{0})(x-(x_{0}+h)).
\]

\end_inset

Dengan melakukan substitusi 
\begin_inset Formula $x_{0}+\theta h$
\end_inset

 untuk 
\begin_inset Formula $x$
\end_inset

,
\begin_inset Formula 
\[
N_{2}(x_{0}+\theta h)=f(x_{0})+\left[f(x_{0}+h)-f(x_{0})\right]\theta+\left[\frac{f(x_{0}+2h)-2f(x_{0}+h)+f(x_{0})}{2}\right](\theta)(\theta-1).
\]

\end_inset

(b) 
\begin_inset Formula $\frac{dx}{d\theta}=h$
\end_inset

 dan 
\begin_inset Formula $\frac{d}{d\theta}N_{2}(x(\theta))=\frac{d}{dx}N_{2}(x)\cdot\frac{dx}{d\theta}$
\end_inset

 sehingga 
\begin_inset Formula ${\displaystyle \frac{d}{dx}N_{2}(x)=\frac{d}{d\theta}N_{2}(x(\theta))\div\frac{dx}{d\theta}=\frac{\frac{d}{d\theta}N_{2}(x(\theta))}{h}}$
\end_inset

.
 Demikian pula, kita memperoleh 
\begin_inset Formula ${\displaystyle \frac{d^{2}}{dx^{2}}N_{2}(x)=\frac{\frac{d^{2}}{d\theta^{2}}N_{2}(x(\theta))}{h^{2}}}$
\end_inset

:
\begin_inset Formula 
\begin{eqnarray*}
\frac{d}{dx}N_{2}(x) & = & \frac{\left[f(x_{0}+h)-f(x_{0})\right]+\frac{f(x_{0}+2h)-2f(x_{0}+h)+f(x_{0})}{2}(2\theta-1)}{h}\\
\frac{d^{2}}{dx^{2}}N_{2}(x) & = & \frac{\frac{f(x_{0}+2h)-2f(x_{0}+h)+f(x_{0})}{2}(2)}{h\cdot h}\\
 & = & \frac{f(x_{0}+2h)-2f(x_{0}+h)+f(x_{0})}{h^{2}}.
\end{eqnarray*}

\end_inset

(c) 
\begin_inset Formula $N_{2}''(x_{0}+\frac{1}{2}h)=\frac{f(x_{0}+2h)-2f(x_{0}+h)+f(x_{0})}{h^{2}}$
\end_inset

 sehingga
\begin_inset Formula 
\[
f''\left(x_{0}+\frac{1}{2}h\right)\approx\frac{f(x_{0}+2h)-2f(x_{0}+h)+f(x_{0})}{h^{2}}.
\]

\end_inset


\end_layout

