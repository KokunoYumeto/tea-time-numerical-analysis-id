 &  & +\frac{(0-(-1))+(0-2)}{h(3-(-1))(3-2)}f(x_{0}+3h)\\
 & = & -\frac{5}{12h}f(x_{0}-h)+\frac{2}{3h}f(x_{0}+2h)+\frac{-1}{4h}f(x_{0}+3h)\\
 & = & \frac{-5f(x_{0}-h)+8f(x_{0}+2h)-3f(x_{0}+3h)}{12h}.
