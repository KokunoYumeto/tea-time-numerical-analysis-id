\begin_layout Description
Bentuk
\begin_inset space ~
\end_inset

Lagrange
\begin_inset space ~
\end_inset

dari
\begin_inset space ~
\end_inset

suatu
\begin_inset space ~
\end_inset

polinom
\begin_inset space ~
\end_inset

interpolasi: 
\begin_inset Index idx
status collapsed

\begin_layout Plain Layout
bentuk Lagrange
\end_layout

\end_inset

Bentuk Lagrange, 
\begin_inset Formula $L_{n}$
\end_inset

, dari polinom berderajat paling tinggi 
\begin_inset Formula $n$
\end_inset

 yang menginterpolasi titik-titik 
\begin_inset Formula $(x_{0},y_{0}),(x_{1},y_{1}),\ldots,(x_{n},y_{n})$
\end_inset

 diberikan oleh rumus
\begin_inset Formula 
\[
L_{n}(x)=\sum_{i=0}^{n}\frac{p_{i}(x)}{p_{i}(x_{i})}y_{i},
\]

\end_inset

dengan 
\begin_inset Formula ${\displaystyle p_{i}(x)=\prod_{\substack{j=0\\
j\neq i
}
}^{n}(x-x_{j})=(x-x_{0})\cdots(x-x_{i-1})(x-x_{i+1})\cdots(x-x_{n})}$
\end_inset

.
\end_layout

\begin_layout Description
Galat
\begin_inset space ~
\end_inset

interpolasi: Untuk 
\begin_inset Formula $P_{n}$
\end_inset

, polinom interpolasi berderajat terendah yang melalui 
\begin_inset Formula $n+1$
\end_inset

 titik 
\begin_inset Formula $(x_{0},y_{0}),(x_{1},y_{1}),\ldots,(x_{n},y_{n})$
\end_inset

, terdapat 
\begin_inset Formula $\xi_{x}\in(a,b)$
\end_inset

 sedemikian sehingga
\begin_inset Formula 
\[
f(x)-P_{n}(x)=\frac{f^{(n+1)}(\xi_{x})}{(n+1)!}(x-x_{0})(x-x_{1})\cdots(x-x_{n}),
\]

\end_inset

dengan asumsi 
\begin_inset Formula $f$
\end_inset

 mempunyai 
\begin_inset Formula $n+1$
\end_inset

 turunan pada 
\begin_inset Formula $(a,b)$
\end_inset

 dan 
\begin_inset Formula $f,f',f'',\ldots,f^{(n)}$
\end_inset

 semuanya kontinu pada 
\begin_inset Formula $[a,b]$
\end_inset

, dengan 
\begin_inset Formula $a=\min(x_{0},\ldots,x_{n},x)$
\end_inset

 dan 
\begin_inset Formula $b=\max(x_{0},\ldots,x_{n},x)$
\end_inset

.
\end_layout

\begin_layout Description
Metode
\begin_inset space ~
\end_inset

Sidi: 
\begin_inset Index idx
status collapsed

\begin_layout Plain Layout
metode Sidi
\end_layout

\end_inset

Metode pencarian akar yang diringkas oleh rumus 
\begin_inset Formula 
\[
x_{n+1}=x_{n}-\frac{f(x_{n})}{p'_{n,k}(x_{n})}
\]

\end_inset

dengan 
\begin_inset Formula $p_{n,k}$
\end_inset

 sebagai polinom interpolasi yang melalui titik-titik
\begin_inset Formula 
\[
(x_{n},f(x_{n})),(x_{n-1},f(x_{n-1})),\ldots,(x_{n-k},f(x_{n-k})).
\]

\end_inset


\end_layout

\begin_layout Description
Metode
\begin_inset space ~
\end_inset

Neville: 
\begin_inset Index idx
status collapsed

\begin_layout Plain Layout
metode Neville
\end_layout

\end_inset

Metode untuk menghitung polinom interpolasi berderajat terendah atau nilai-nilainya
 berdasarkan relasi rekursif
\begin_inset Formula 
\begin{eqnarray*}
P_{i,m+1}(x) & = & \frac{(x-x_{i})P_{i+1,m}(x)-(x-x_{i+m+1})P_{i,m}(x)}{x_{i+m+1}-x_{i}}\\
P_{i,0}(x) & = & f(x_{i})
\end{eqnarray*}

\end_inset

dengan 
\begin_inset Formula $P_{k,l}$
\end_inset

 sebagai polinom berderajat terendah yang menginterpolasi data
\begin_inset Formula 
\[
(x_{k},f(x_{k})),(x_{k+1},f(x_{k+1})),\ldots,(x_{k+l},f(x_{k+l})).
\]

\end_inset


\end_layout

