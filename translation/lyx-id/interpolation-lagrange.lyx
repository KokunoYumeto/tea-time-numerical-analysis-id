\begin_layout Standard
\noindent
Dengan mengurangkan polinom ini dari galat, 
\begin_inset Formula $e(t)=P_{n}(t)-f(t)$
\end_inset

, kita memperoleh fungsi
\begin_inset Formula 
\[
g(t)=e(t)-\Lambda(t),
\]

\end_inset

yang bernilai nol untuk semua 
\begin_inset Formula $t=x_{0},x_{1},\ldots,x_{n},x$
\end_inset

.
 Karena 
\begin_inset Formula $g,g',\ldots,g^{(n)}$
\end_inset

 semuanya kontinu pada 
\begin_inset Formula $[a,b]$
\end_inset

 dan 
\begin_inset Formula $g^{(n+1)}$
\end_inset

 ada pada 
\begin_inset Formula $(a,b)$
\end_inset

, berdasarkan Teorema Rolle yang Diperumum terdapat 
\begin_inset Formula $\xi_{x}\in(a,b)$
\end_inset

 sedemikian sehingga 
\begin_inset Formula $g^{(n+1)}(\xi_{x})=0$
\end_inset

.
 Di sisi lain, 
\begin_inset Formula 
\begin{eqnarray*}
g^{(n+1)}(\xi_{x}) & = & e^{(n+1)}(\xi_{x})-\Lambda^{(n+1)}(\xi_{x})\\
 & = & P_{n}^{(n+1)}(\xi_{x})-f^{(n+1)}(\xi_{x})-\Lambda^{(n+1)}(\xi_{x}),
\end{eqnarray*}

\end_inset

dan 
\begin_inset Formula $P_{n}$
\end_inset

 merupakan polinom berderajat paling tinggi 
\begin_inset Formula $n$
\end_inset

.
 Oleh karena itu, 
\begin_inset Formula $P_{n}^{(n+1)}(t)=0$
\end_inset

 untuk setiap 
\begin_inset Formula $t$
\end_inset

 dan kita memperoleh 
\begin_inset Formula $g^{(n+1)}(\xi_{x})=-f^{(n+1)}(\xi_{x})-\Lambda^{(n+1)}(\xi_{x})=0$
\end_inset

.
 Akibatnya, 
\begin_inset Formula 
\[
f^{(n+1)}(\xi_{x})=-\Lambda^{(n+1)}(\xi_{x}).
\]

\end_inset

Namun, 
\begin_inset Formula $\Lambda$
\end_inset

 adalah polinom berderajat 
\begin_inset Formula $n+1$
\end_inset

 dalam 
\begin_inset Formula $t$
\end_inset

, sehingga turunan ke-
\begin_inset Formula $(n+1)$
\end_inset

 terhadap 
\begin_inset Formula $t$
\end_inset

 konstan terhadap 
\begin_inset Formula $t$
\end_inset

.
 Kita menuliskan 
\begin_inset Formula $\Lambda$
\end_inset

 sebagai
\begin_inset Formula 
\[
\Lambda(t)=\frac{P_{n}(x)-f(x)}{(x-x_{0})(x-x_{1})\cdots(x-x_{n})}\left[t^{n+1}+b_{n}t^{n}+\cdots+b_{0}t^{0}\right]
\]

\end_inset

untuk beberapa konstanta 
\begin_inset Formula $b_{n},b_{n-1},\ldots,b_{0}$
\end_inset

, dan akibatnya,
\begin_inset Formula 
\[
\Lambda^{(n+1)}(t)=\frac{P_{n}(x)-f(x)}{(x-x_{0})(x-x_{1})\cdots(x-x_{n})}\cdot(n+1)!,
\]

\end_inset

dengan substitusi kita memperoleh
\begin_inset Formula 
\[
f^{(n+1)}(\xi_{x})=\frac{f(x)-P_{n}(x)}{(x-x_{0})(x-x_{1})\cdots(x-x_{n})}\cdot(n+1)!
\]

\end_inset

atau, secara ekuivalen,
\begin_inset Formula 
\[
\frac{f^{(n+1)}(\xi)}{(n+1)!}(x-x_{0})(x-x_{1})\cdots(x-x_{n})=f(x)-P_{n}(x)
\]

\end_inset

seperti yang hendak dibuktikan.
\end_layout

