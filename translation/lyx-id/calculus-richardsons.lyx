\begin_layout Description
Ekstrapolasi
\begin_inset space ~
\end_inset

Richardson: Jika hampiran 
\begin_inset Formula $\tilde{p}$
\end_inset

 diketahui berbentuk
\begin_inset Formula 
\[
\tilde{p}(h)=p+c_{1}h^{m_{1}}+O(h^{m_{2}})
\]

\end_inset

maka hampiran 
\begin_inset Formula 
\[
\frac{\alpha^{-m_{1}}\tilde{p}\left(\alpha h\right)-\tilde{p}(h)}{\alpha^{-m_{1}}-1}
\]

\end_inset

akan memiliki galat 
\begin_inset Formula $O(h^{m_{2}})$
\end_inset

.
\end_layout

