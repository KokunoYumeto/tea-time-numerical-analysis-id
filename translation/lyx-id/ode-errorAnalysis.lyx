\begin_layout Section
Analisis Galat
\begin_inset CommandInset label
LatexCommand label
name "sec:Runge-Kutta-Error-Analysis"

\end_inset


\begin_inset Index idx
status collapsed

\begin_layout Plain Layout
metode Runge-Kutta
\end_layout

\end_inset


\end_layout

\begin_layout Standard
Bagian 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:Runge-Kutta-Methods"

\end_inset

 berakhir dengan pengamatan yang misterius (dan meresahkan?) bahwa PDB-Simpson
 tidak memenuhi harapan.
 Berdasarkan pemecah PDB lainnya,
 kita memperkirakan laju kekonvergenan PDB-Simpson sebesar
 
\begin_inset Formula $O(h^{4})$
\end_inset

 karena Aturan Simpson, yang mendasari PDB-Simpson, memiliki galat pemenggalan
 lokal sebesar 
\begin_inset Formula $O(h^{5})$
\end_inset

.
\end_layout

\begin_layout Standard
Penjelasannya berakar pada fakta bahwa kita menyelesaikan PDB
 berbentuk 
\begin_inset Formula $\dot{y}=f(t,y)$
\end_inset

, yang turunannya merupakan fungsi dari dua variabel, 
\begin_inset Formula $t$
\end_inset

 dan 
\begin_inset Formula $y$
\end_inset

.
 Untuk memahami analisis galat, diperlukan penggunaan intensif turunan parsial dan
 aturan rantai.
 Seperti biasa, kita menggunakan teorema Taylor dan menuliskan
\begin_inset Formula 
\[
y(t_{0}+h)=y(t_{0})+h\dot{y}(t_{0})+\frac{1}{2}h^{2}\ddot{y}(t_{0})+\frac{1}{6}h^{3}\dddot{y}(t_{0})+\cdots.
\]

\end_inset

Setiap turunan 
\begin_inset Formula $y$
\end_inset

 dapat diganti dengan suatu fungsi dari 
\begin_inset Formula $f$
\end_inset

 dan turunan-turunan parsialnya, dimulai dengan 
\begin_inset Formula $\dot{y}$
\end_inset

, yang diberikan oleh PDB
 yang hendak kita selesaikan.
\begin_inset Formula 
\begin{eqnarray*}
\dot{y} & = & f(t,y)\\
\ddot{y}=\frac{d}{dt}\dot{y} & = & \frac{d}{dt}f(t,y)=f_{t}(t,y)+f_{y}(t,y)\dot{y}=f_{t}(t,y)+f_{y}(t,y)\cdot f(t,y)\\
 & \vdots
\end{eqnarray*}

\end_inset

Dengan menghilangkan penulisan eksplisit argumen 
\begin_inset Formula $t$
\end_inset

 dan 
\begin_inset Formula $y$
\end_inset

,
\begin_inset Formula 
\begin{eqnarray*}
\dot{y} & = & f\\
\ddot{y} & = & f_{t}+f_{y}f\\
\dddot{y} & = & f_{tt}+f_{ty}f+(f_{yt}+f_{yy}f)f+f_{y}(f_{t}+f_{y}f)\\
 & = & f_{tt}+2f_{ty}f+f_{yy}f^{2}+f_{t}f_{y}+f_{y}^{2}f\\
 & \vdots
\end{eqnarray*}

\end_inset

sehingga 
\begin_inset Formula $y(t_{0}+h)=y(t_{0})+h\dot{y}(t_{0})+\frac{1}{2}h^{2}\ddot{y}(t_{0})+\frac{1}{6}h^{3}\dddot{y}(t_{0})+\cdots$
\end_inset

 dalam bentuk 
\begin_inset Formula $f$
\end_inset

 adalah
\begin_inset Formula 
\[
y(t_{0}+h)=y(t_{0})+hf+\frac{1}{2}h^{2}(f_{t}+f_{y}f)+\frac{1}{6}h^{3}(f_{tt}+2f_{ty}f+f_{yy}f^{2}+f_{t}f_{y}+f_{y}^{2}f)+\cdots,
\]

\end_inset

dan sebagai pemecah PDB
 (dengan mengganti 
\begin_inset Formula $y(t_{0})$
\end_inset

 dengan 
\begin_inset Formula $y_{i}$
\end_inset

 dan 
\begin_inset Formula $y(t_{0}+h)$
\end_inset

 dengan 
\begin_inset Formula $y_{i+1}$
\end_inset

),
\begin_inset Formula 
\begin{equation}
y_{i+1}=y_{i}+hf+\frac{1}{2}h^{2}(f_{t}+f_{y}f)+\frac{1}{6}h^{3}(f_{tt}+2f_{ty}f+f_{yy}f^{2}+f_{t}f_{y}+f_{y}^{2}f)+\cdots.\label{eq:twoVariableTaylorSeries}
\end{equation}

\end_inset

Menulis ulang polinomial Taylor berderajat tinggi dalam bentuk 
\begin_inset Formula $f$
\end_inset

 dengan cepat menjadi rumit.
 Kita akan berfokus pada analisis yang hanya memerlukan 
\begin_inset Formula $\dot{y}$
\end_inset

, 
\begin_inset Formula $\ddot{y}$
\end_inset

, dan 
\begin_inset Formula $\dddot{y}$
\end_inset

.
\end_layout

\begin_layout Standard
Pemecah PDB
 pada Bagian 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:Runge-Kutta-Methods"

\end_inset

 berbentuk
\family roman
\series medium
\shape up
\size normal
\emph off
\bar no
\strikeout off
\uuline off
\uwave off
\noun off
\color none

\begin_inset Formula 
\begin{eqnarray}
k_{1} & = & f(t_{i},y_{i})\nonumber \\
k_{2} & = & f\left(t_{i}+\beta_{2}h,y_{i}+\beta_{2}hk_{1}\right)\nonumber \\
k_{3} & = & f(t_{i}+\beta_{3}h,y_{i}+\beta_{3}hk_{2})\nonumber \\
 & \vdots\nonumber \\
k_{s} & = & f(t_{i}+\beta_{s}h,y_{i}+\beta_{s}hk_{s-1})\nonumber \\
y_{i+1} & = & y_{i}+h\left[\alpha_{1}k_{1}+\alpha_{2}k_{2}+\alpha_{3}k_{3}+\cdots+\alpha_{s}k_{s}\right].\label{eq:rungeKuttaGeneral}
\end{eqnarray}

\end_inset

Kita sebenarnya belum melihat pemecah PDB
 dengan 
\begin_inset Formula $s>3$
\end_inset

 di 
\family default
\series default
\shape default
\size default
\emph default
\bar default
\strikeout default
\uuline default
\uwave default
\noun default
\color inherit
Bagian 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:Runge-Kutta-Methods"

\end_inset

, tetapi proses yang kita ikuti jelas akan memerlukannya jika terdapat lebih
 dari tiga simpul dalam rumus integrasi yang mendasarinya.
 
\end_layout

\begin_layout Standard
Selisih antara 
\begin_inset Formula $y(t_{0}+h)$
\end_inset

 dari (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:twoVariableTaylorSeries"

\end_inset

) dan 
\begin_inset Formula $y_{i+1}$
\end_inset

 dari (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:rungeKuttaGeneral"

\end_inset

) adalah galat pemenggalan lokal pemecah PDB
 (galat ketika mengambil satu langkah).
 Untuk menuliskan galat pemenggalan ini dalam bentuk 
\begin_inset Formula $O(h^{\ell})$
\end_inset

, kita perlu mengembangkan setiap 
\begin_inset Formula $k_{j}$
\end_inset

 ke dalam polinomial Taylor-nya.
 Diperlukan teorema Taylor dalam dua variabel.
\end_layout

\begin_layout Theorem
\begin_inset CommandInset label
LatexCommand label
name "thm:twoVariableTaylors"

\end_inset


\begin_inset Index idx
status collapsed

\begin_layout Plain Layout
Teorema ! Taylor dua variabel
\end_layout

\end_inset

Misalkan 
\begin_inset Formula $f(t,y)$
\end_inset

 beserta semua turunan parsialnya yang berorde 
\begin_inset Formula $n+1$
\end_inset

 atau lebih rendah kontinu pada persegi panjang 
\begin_inset Formula $D=\{(t,y):a\leq t\leq b,c\leq y\leq d\}$
\end_inset

, dan misalkan 
\begin_inset Formula $(t_{0},y_{0})\in D$
\end_inset

.
 Maka untuk setiap 
\begin_inset Formula $(t,y)\in D$
\end_inset

, terdapat 
\begin_inset Formula $\xi\in(a,b)$
\end_inset

 dan 
\begin_inset Formula $\mu\in(c,d)$
\end_inset

 sedemikian sehingga 
\begin_inset Formula 
\begin{eqnarray*}
f(t,y) & = & f(t_{0},y_{0})+\left[(t-t_{0})\cdot f_{t}(t_{0},y_{0})+(y-y_{0})\cdot f_{y}(t_{0},y_{0})\right]\\
 &  & +\frac{1}{2}\left[(t-t_{0})^{2}f_{tt}(t_{0},y_{0})+2(t-t_{0})(y-y_{0})\cdot f_{ty}(t_{0},y_{0})+(y-y_{0})^{2}f_{yy}(t_{0},y_{0})\right]\\
 &  & +\cdots+\\
 &  & \frac{1}{n!}\left[\sum_{j=0}^{n}\left(\begin{array}{c}
n\\
j
\end{array}\right)(t-t_{0})^{n-j}(y-y_{0})^{j}\frac{\partial^{n}f}{\partial t^{n-j}\partial y^{j}}(t_{0},y_{0})\right]\\
 &  & +\frac{1}{(n+1)!}\left[\sum_{j=0}^{n+1}\left(\begin{array}{c}
n+1\\
j
\end{array}\right)(t-t_{0})^{n+1-j}(y-y_{0})^{j}\frac{\partial^{n+1}f}{\partial t^{n+1-j}\partial y^{j}}(\xi,\mu)\right].
\end{eqnarray*}

\end_inset


\end_layout

\begin_layout Standard
\noindent
Seperti pada teorema Taylor (satu variabel), 
\begin_inset Formula $n+1$
\end_inset

 suku pertama membentuk polinomial Taylor dan suku terakhir adalah suku sisa.
 
\end_layout

\begin_layout Standard
Sebagai ilustrasi, kita ambil 
\begin_inset Formula $f(t,y)=-\frac{y}{t}+t^{2}$
\end_inset

 dan menghitung polinomial Taylor derajat dua beserta suku sisanya yang dikembangkan di sekitar
 
\begin_inset Formula $(t_{0},y_{0})=(1,1)$
\end_inset

.
 Untuk itu, kita memerlukan semua turunan parsial 
\begin_inset Formula $f$
\end_inset

 hingga dan termasuk orde 3.
\begin_inset Formula 
\begin{eqnarray*}
f_{t} & = & \frac{y}{t^{2}}+2t\\
f_{y} & = & -\frac{1}{t}\\
f_{tt} & = & -2\frac{y}{t^{3}}+2\\
f_{ty}=f_{yt} & = & \frac{1}{t^{2}}\\
f_{yy} & = & 0\\
f_{ttt} & = & 6\frac{y}{t^{4}}\\
f_{tty}=f_{tyt}=f_{ytt} & = & -\frac{2}{t^{3}}\\
f_{tyy}=f_{yty}=f_{yyt} & = & 0\\
f_{yyy} & = & 0.
\end{eqnarray*}

\end_inset

Dengan demikian,
\begin_inset Formula 
\begin{eqnarray*}
f(1,1) & = & 0\\
f_{t}(1,1) & = & 3\\
f_{y}(1,1) & = & -1\\
f_{tt}(1,1) & = & 0\\
f_{ty}(1,1) & = & 1\\
f_{yy}(1,1) & = & 0\\
f_{ttt}(\xi,\mu) & = & 6\frac{\mu}{\xi^{4}}\\
f_{tty}(\xi,\mu) & = & -\frac{2}{\xi^{3}}\\
f_{tyy}(\xi,\mu) & = & 0\\
f_{yyy}(\xi,\mu) & = & 0.
\end{eqnarray*}

\end_inset

Oleh karena itu, polinomial Taylor derajat dua untuk 
\begin_inset Formula $f(t,y)$
\end_inset

 adalah
\begin_inset Formula 
\begin{eqnarray*}
T_{2}(t,y) & = & f(1,1)+\left[(t-1)\cdot f_{t}(1,1)+(y-1)\cdot f_{y}(1,1)\right]\\
 &  & +\frac{1}{2}\left[(t-1)^{2}f_{tt}(1,1)+2(t-1)(y-1)\cdot f_{ty}(1,1)+(y-1)^{2}f_{yy}(1,1)\right]\\
 & = & 0+3(t-1)-(y-1)+0(t-1)^{2}+(t-1)(y-1)+0(y-1)^{2}\\
 & = & 3(t-1)-(y-1)+(t-1)(y-1)
\end{eqnarray*}

\end_inset

dengan suku sisa
\begin_inset Formula 
\begin{eqnarray*}
R_{2}(t,y) & = & \frac{1}{6}\left[(t-1)^{3}f_{ttt}(\xi,\mu)+3(t-1)^{2}(y-1)f_{tty}(\xi,\mu)+3(t-1)(y-1)^{2}f_{tyy}(\xi,\mu)+(y-1)^{3}f_{yyy}(\xi,\mu)\right]\\
 & = & \frac{1}{6}\left[(t-1)^{3}\cdot6\frac{\mu}{\xi^{4}}-3(t-1)^{2}(y-1)\cdot\frac{2}{\xi^{3}}+3(t-1)(y-1)^{2}\cdot0+(y-1)^{3}\cdot0\right]\\
 & = & (t-1)^{3}\frac{\mu}{\xi^{4}}-(t-1)^{2}(y-1)\frac{1}{\xi^{3}}.
\end{eqnarray*}

\end_inset


\end_layout

\begin_layout Standard
Secara lebih umum, misalkan kita ingin memperoleh ekspansi polinomial Taylor
 dari bentuk seperti 
\begin_inset Formula $f(t_{i}+\beta_{j}h,y_{i}+\beta_{j}hk_{j-1})$
\end_inset

, sebagaimana dalam pemecah PDB
 kita.
 Dengan mengembangkannya di sekitar 
\begin_inset Formula $(t_{i},y_{i})$
\end_inset

, kita tetapkan 
\begin_inset Formula $t_{0}=t_{i}$
\end_inset

, 
\begin_inset Formula $y_{0}=y_{i}$
\end_inset

, 
\begin_inset Formula $t=t_{i}+\beta_{j}h$
\end_inset

, dan 
\begin_inset Formula $y=y_{i}+\beta_{j}hk_{j-1}$
\end_inset

.
 Jadi, 
\begin_inset Formula $t-t_{0}=\beta_{j}h$
\end_inset

 dan 
\begin_inset Formula $y-y_{0}=\beta_{j}hk_{j-1}$
\end_inset

, sedangkan polinomial Taylor derajat dua tanpa menuliskan argumen secara eksplisit
 
\begin_inset Formula $t_{i}$
\end_inset

 dan 
\begin_inset Formula $y_{i}$
\end_inset

 pada ruas kanan adalah 
\begin_inset Formula 
\begin{eqnarray*}
f(t_{i}+\beta_{j}h,y_{i}+\beta_{j}hk_{j-1}) & = & f+h\beta_{j}\left[f_{t}+k_{j-1}f_{y}\right]+\frac{1}{2}h^{2}\beta_{j}^{2}\left[f_{tt}+2k_{j-1}f_{ty}+k_{j-1}^{2}f_{yy}\right]
\end{eqnarray*}

\end_inset

dengan suku sisa 
\begin_inset Formula $O(h^{3})$
\end_inset

.
 
\end_layout

\begin_layout Standard
Khususnya, ketika kita menetapkan 
\begin_inset Formula $j=1$
\end_inset

, 
\begin_inset Formula $\beta_{j}=\beta_{1}=0$
\end_inset

, kita peroleh
\begin_inset Formula 
\[
k_{1}=f(t_{i},y_{i})=f.
\]

\end_inset

Ketika kita menetapkan 
\begin_inset Formula $j=2$
\end_inset

, 
\begin_inset Formula 
\begin{eqnarray*}
k_{2} & = & f\left(t_{i}+\beta_{2}h,y_{i}+\beta_{2}hk_{1}\right)\\
 & = & f+h\beta_{2}\left[f_{t}+ff_{y}\right]+\frac{1}{2}h^{2}\beta_{2}^{2}\left[f_{tt}+2ff_{ty}+f^{2}f_{yy}\right]+O(h^{3}).
\end{eqnarray*}

\end_inset

Perhitungan 
\begin_inset Formula $k_{3}$
\end_inset

 sedikit lebih rumit karena melibatkan 
\begin_inset Formula $k_{2}^{2}$
\end_inset

.
 Namun, sebelum langsung menyelaminya, pertimbangkan apa yang akan kita lakukan dengan 
\begin_inset Formula $k_{3}$
\end_inset

 terlebih dahulu.
 Setelah menghitung 
\begin_inset Formula $k_{1}$
\end_inset

, 
\begin_inset Formula $k_{2}$
\end_inset

, dan 
\begin_inset Formula $k_{3}$
\end_inset

, kita akan menyubstitusikan masing-masing ke dalam rumus
\begin_inset Formula 
\begin{equation}
y_{i+1}=y_{i}+h\left[\alpha_{1}k_{1}+\alpha_{2}k_{2}+\alpha_{3}k_{3}\right]\label{eq:rungeKutta3ks}
\end{equation}

\end_inset

dan mengurangkan hasilnya dari (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:twoVariableTaylorSeries"

\end_inset

).
 Untuk pembahasan ini, kita mencari metode dengan galat pemenggalan
 lokal sebesar 
\begin_inset Formula $O(h^{4})$
\end_inset

.
 Karena itu, kita hanya perlu mempertahankan suku konstanta dan suku yang memuat faktor
 berupa 
\begin_inset Formula $h^{3}$
\end_inset

, 
\begin_inset Formula $h^{2}$
\end_inset

, atau 
\begin_inset Formula $h$
\end_inset

 dalam persamaan (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:rungeKutta3ks"

\end_inset

).
 Suku-suku dengan pangkat 
\begin_inset Formula $h$
\end_inset

 yang lebih tinggi tidak relevan.
 Suku-suku tersebut akan terserap ke dalam 
\begin_inset Formula $O(h^{4})$
\end_inset

.
 Karena jumlah 
\begin_inset Formula $\alpha_{1}k_{1}+\alpha_{2}k_{2}+\alpha_{3}k_{3}$
\end_inset

 dikalikan dengan 
\begin_inset Formula $h$
\end_inset

, kita hanya perlu mempertahankan suku yang memuat faktor hingga 
\begin_inset Formula $h^{2}$
\end_inset

 dalam 
\begin_inset Formula $k_{1}$
\end_inset

, 
\begin_inset Formula $k_{2}$
\end_inset

, dan 
\begin_inset Formula $k_{3}$
\end_inset

.
 Dengan melihat ekspansi 
\begin_inset Formula $k_{3}$
\end_inset

:
\begin_inset Formula 
\begin{eqnarray*}
k_{3} & = & f\left(t_{i}+\beta_{3}h,y_{i}+\beta_{3}hk_{2}\right)\\
 & = & f+h\beta_{3}\left[f_{t}+k_{2}f_{y}\right]+\frac{1}{2}h^{2}\beta_{3}^{2}\left[f_{tt}+2k_{2}f_{ty}+k_{2}^{2}f_{yy}\right]
\end{eqnarray*}

\end_inset

kita melihat bahwa hanya suku 
\begin_inset Formula $\frac{1}{2}h^{2}\beta_{3}^{2}\cdot k_{2}^{2}f$
\end_inset

 yang memuat 
\begin_inset Formula $k_{2}^{2}$
\end_inset

, dan suku itu sudah memiliki faktor 
\begin_inset Formula $h^{2}$
\end_inset

.
 Akibatnya, kita hanya perlu menyertakan suku konstanta dari 
\begin_inset Formula $k_{2}^{2}$
\end_inset

.
 Suku-suku lain dari 
\begin_inset Formula $k_{2}^{2}$
\end_inset

 menjadi bagian dari 
\begin_inset Formula $O(h^{4})$
\end_inset

.
 Ternyata tidak terlalu buruk!
\begin_inset Formula 
\begin{eqnarray*}
k_{2}^{2} & = & f^{2}+O(h).
\end{eqnarray*}

\end_inset

Demikian pula, ketika kita menyubstitusikan bentuk-bentuk untuk 
\begin_inset Formula $k_{2}$
\end_inset

 ke dalam 
\begin_inset Formula $k_{3}$
\end_inset

, kita akan berhati-hati menghindari suku apa pun yang akan menghasilkan faktor 
\begin_inset Formula $h$
\end_inset

 berpangkat lebih besar dari 2:
\begin_inset Formula 
\begin{eqnarray*}
k_{3} & = & f+h\beta_{3}\left[f_{t}+\left(f+h\beta_{2}\left[f_{t}+ff_{y}\right]\right)f_{y}\right]\\
 &  & +\frac{1}{2}h^{2}\beta_{3}^{2}\left[f_{tt}+2(f)f_{ty}+\left(f^{2}\right)f_{yy}\right]+O(h^{3})\\
 & = & f+h\beta_{3}f_{t}+h\beta_{3}ff_{y}+h^{2}\beta_{2}\beta_{3}(f_{t}f_{y}+ff_{y}^{2})\\
 &  & +\frac{1}{2}h^{2}\beta_{3}^{2}\left[f_{tt}+2ff_{ty}+f^{2}f_{yy}\right]+O(h^{3}).
\end{eqnarray*}

\end_inset


\end_layout

\begin_layout Standard
Setelah semua perhitungan terperinci itu, sekarang saat yang tepat untuk bersandar sejenak dan
 melihat apa yang telah kita peroleh.
 Kita telah mengembangkan semua suku dalam (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:rungeKuttaGeneral"

\end_inset

) untuk 
\begin_inset Formula $s=3$
\end_inset

 dan siap membandingkan hasilnya dengan ekspansi Taylor PDB
 pada (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:twoVariableTaylorSeries"

\end_inset

).
 Selisih keduanya adalah galat pemenggalan lokal, sehingga kita akan
 mencari pangkat terkecil dari 
\begin_inset Formula $h$
\end_inset

 yang tersisa setelah pengurangan.
 Dengan menyalin kedua persamaan di sini agar mudah dirujuk, kita mengurangkan
\begin_inset Formula 
\[
y_{i+1}=y_{i}+hf+\frac{1}{2}h^{2}(f_{t}+f_{y}f)+\frac{1}{6}h^{3}(f_{tt}+2f_{ty}f+f_{yy}f^{2}+f_{t}f_{y}+f_{y}^{2}f)+O(h^{4})
\]

\end_inset

dari
\begin_inset Formula 
\begin{eqnarray*}
y_{i+1} & = & y_{i}+h\left[\alpha_{1}k_{1}+\alpha_{2}k_{2}+\alpha_{3}k_{3}\right]\\
 & = & y_{i}+h\alpha_{1}k_{1}+h\alpha_{2}k_{2}+h\alpha_{3}k_{3}\\
 & = & y_{i}+h\alpha_{1}f\\
 &  & +h\alpha_{2}\left(f+h\beta_{2}\left[f_{t}+ff_{y}\right]+\frac{1}{2}h^{2}\beta_{2}^{2}\left[f_{tt}+2ff_{ty}+f^{2}f_{yy}\right]+O(h^{3})\right)\\
 &  & +h\alpha_{3}\left(f+h\beta_{3}f_{t}+h\beta_{3}ff_{y}+h^{2}\beta_{2}\beta_{3}(f_{t}f_{y}+ff_{y}^{2})+\frac{1}{2}h^{2}\beta_{3}^{2}\left[f_{tt}+2ff_{ty}+f^{2}f_{yy}\right]+O(h^{3})\right).
\end{eqnarray*}

\end_inset

Suku konstanta (suku yang tidak memuat faktor 
\begin_inset Formula $h$
\end_inset

) pada setiap persamaan hanyalah 
\begin_inset Formula $y_{i}$
\end_inset

, sehingga tidak ada konstanta yang tersisa setelah pengurangan.
 Selisih suku-suku yang melibatkan 
\begin_inset Formula $h$
\end_inset

 adalah 
\begin_inset Formula $hf-(h\alpha_{1}f+h\alpha_{2}f+h\alpha_{3}f)=hf(1-(\alpha_{1}+\alpha_{2}+\alpha))$
\end_inset

, jadi agar tidak ada 
\begin_inset Formula $h$
\end_inset

 yang tersisa dalam selisih, harus berlaku 
\begin_inset Formula 
\[
\alpha_{1}+\alpha_{2}+\alpha_{3}=1.
\]

\end_inset

Selisih suku-suku yang melibatkan 
\begin_inset Formula $h^{2}f_{t}$
\end_inset

 adalah 
\begin_inset Formula $\frac{1}{2}h^{2}f_{t}-(h^{2}\alpha_{2}\beta_{2}f_{t}+h^{2}\alpha_{3}\beta_{3}f_{t})=h^{2}f_{t}(\frac{1}{2}-(\alpha_{2}\beta_{2}+\alpha_{3}\beta_{3}))$
\end_inset

, jadi agar tidak ada 
\begin_inset Formula $h^{2}f_{t}$
\end_inset

 yang tersisa dalam selisih, harus berlaku
\begin_inset Formula 
\[
\alpha_{2}\beta_{2}+\alpha_{3}\beta_{3}=\frac{1}{2}.
\]

\end_inset

Demikian pula, kita meninjau selisih suku-suku lainnya untuk memperoleh
 syarat-syarat berikut bagi 
\begin_inset Formula $\alpha_{j}$
\end_inset

 dan 
\begin_inset Formula $\beta_{j}$
\end_inset

.
\end_layout

