\begin_layout Plain Layout

function p = bisectionWhile(a,b,f,tol)
\end_layout

\begin_layout Plain Layout

  p = a;
\end_layout

\begin_layout Plain Layout

  err = abs(b-a);
\end_layout

\begin_layout Plain Layout

  FA = f(a);
\end_layout

