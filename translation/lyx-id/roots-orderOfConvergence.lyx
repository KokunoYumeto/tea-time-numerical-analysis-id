\begin_layout Description
Metode
\begin_inset space ~
\end_inset

delta-kuadrat
\begin_inset space ~
\end_inset

Aitken: Jika 
\begin_inset Formula $\langle p_{n}\rangle$
\end_inset

 konvergen secara linear ke 
\begin_inset Formula $p$
\end_inset

, barisan 
\begin_inset Formula $\langle a_{n}\rangle$
\end_inset

 yang didefinisikan oleh 
\begin_inset Formula $a_{n}=p_{n}-\frac{(p_{n+1}-p_{n})^{2}}{p_{n+2}-2p_{n+1}+p_{n}}$
\end_inset

 konvergen lebih cepat ke 
\begin_inset Formula $p$
\end_inset

, tetapi tetap berorde linear.
\end_layout

\begin_layout Description
Batas
\begin_inset space ~
\end_inset

Galat
\begin_inset space ~
\end_inset

Titik
\begin_inset space ~
\end_inset

Tetap: 
\begin_inset Index idx
status collapsed

\begin_layout Plain Layout
Teorema ! Batas Galat Titik Tetap
\end_layout

\end_inset

 Misalkan 
\begin_inset Formula $f$
\end_inset

 adalah fungsi terdiferensial yang memiliki titik tetap 
\begin_inset Formula $\hat{x}$
\end_inset

 dan misalkan 
\begin_inset Formula $[a,b]$
\end_inset

 adalah interval yang memuat 
\begin_inset Formula $\hat{x}$
\end_inset

.
  Jika 
\begin_inset Formula $|f'(x)|\leq M<1$
\end_inset

 untuk setiap 
\begin_inset Formula $x\in[a,b]$
\end_inset

 dan 
\begin_inset Formula $f([a,b])\subseteq[a,b]$
\end_inset

, maka untuk sembarang nilai awal 
\begin_inset Formula $x_{0}\in[a,b]$
\end_inset

, iterasi titik tetap dengan 
\begin_inset Formula $x_{k+1}=f(x_{k})$
\end_inset

 untuk setiap 
\begin_inset Formula $k\geq0$
\end_inset

 menghasilkan hampiran terhadap 
\begin_inset Formula $\hat{x}$
\end_inset

 dengan galat absolut tidak lebih dari 
\begin_inset Formula $M^{k}|x_{0}-\hat{x}|$
\end_inset

.
\end_layout

\begin_layout Description
Orde
\begin_inset space ~
\end_inset

Kekonvergenan
\begin_inset space ~
\end_inset

untuk
\begin_inset space ~
\end_inset

Iterasi
\begin_inset space ~
\end_inset

Titik
\begin_inset space ~
\end_inset

Tetap: Misalkan 
\begin_inset Formula $f$
\end_inset

 adalah fungsi dengan titik tetap 
\begin_inset Formula $\hat{x}$
\end_inset

 dan 
\begin_inset Formula $f'(\hat{x})$
\end_inset

 ada.
 Misalkan 
\begin_inset Formula $x_{0},x_{1},x_{2},\ldots$
\end_inset

 merupakan barisan yang diperoleh dari iterasi titik tetap (
\begin_inset Formula $x_{k+1}=f(x_{k})$
\end_inset

 untuk setiap 
\begin_inset Formula $k\geq1$
\end_inset

) sedemikian sehingga 
\begin_inset Formula ${\displaystyle \lim_{k\to\infty}x_{k}=\hat{x}}$
\end_inset

 dan 
\begin_inset Formula $x_{k}\neq\hat{x}$
\end_inset

 untuk setiap 
\begin_inset Formula $k=0,1,2,\ldots$
\end_inset

.
 Maka barisan 
\begin_inset Formula $\langle x_{n}\rangle$
\end_inset

 konvergen secara linear ke 
\begin_inset Formula $\hat{x}$
\end_inset

 jika 
\begin_inset Formula $f'(\hat{x})\neq0$
\end_inset

 dan berorde setidaknya kuadratik jika 
\begin_inset Formula $f'(\hat{x})=0$
\end_inset

.
\end_layout

