\begin_layout Plain Layout

    if (FP == 0)
\end_layout

\begin_layout Plain Layout

      return
\end_layout

\begin_layout Plain Layout

    end%if
\end_layout

\begin_layout Plain Layout

    if (FA*FP > 0)
\end_layout

\begin_layout Plain Layout

      a = p;
\end_layout

\begin_layout Plain Layout

      FA = FP;
\end_layout

\begin_layout Plain Layout

    else
\end_layout

\begin_layout Plain Layout

      b = p;
\end_layout

\begin_layout Plain Layout

    end%if
\end_layout

\begin_layout Plain Layout

  end%while
\end_layout

\begin_layout Plain Layout

end%function 
