Tidak ada orde kekonvergenan 
\begin_inset Index idx
status collapsed

\begin_layout Plain Layout
kekonvergenan ! orde
\end_layout

\end_inset

 yang kurang dari satu, sebab jika 
\begin_inset Formula $\lim_{n\to\infty}\frac{\left|p_{n+1}-p\right|}{\left|p_{n}-p\right|^{\alpha}}=\lambda$
\end_inset

 untuk suatu 
\begin_inset Formula $0<\alpha<1$
\end_inset

, maka 
\begin_inset Formula 
\begin{eqnarray*}
\lim_{n\to\infty}\frac{|p_{n+1}-p|}{|p_{n}-p|} & = & \lim_{n\to\infty}\frac{|p_{n+1}-p|}{|p_{n}-p|^{\alpha}}\cdot|p_{n}-p|^{\alpha-1},
\end{eqnarray*}

\end_inset

yang merupakan kontradiksi.
 Di satu sisi, uji rasio menyiratkan bahwa 
\begin_inset Formula $\lim_{n\to\infty}\frac{|p_{n+1}-p|}{|p_{n}-p|}$
\end_inset

 ada dan kurang dari atau sama dengan 1.
 Di sisi lain, 
\begin_inset Formula $\alpha<1\implies\alpha-1<0$
\end_inset

 sehingga ketika 
\begin_inset Formula $|p_{n}-p|$
\end_inset

 bernilai kecil, 
\begin_inset Formula $|p_{n}-p|^{\alpha-1}$
\end_inset

 bernilai besar.
 Oleh karena itu, 
\begin_inset Formula $\lim_{n\to\infty}\frac{|p_{n+1}-p|}{|p_{n}-p|^{\alpha}}\cdot|p_{n}-p|^{\alpha-1}$
\end_inset

 tidak ada.
 Untuk membuktikannya secara ketat, misalkan 
\begin_inset Formula $M$
\end_inset

 adalah sebarang bilangan real.
 Maka terdapat 
\begin_inset Formula $N_{1}$
\end_inset

 sedemikian sehingga 
\begin_inset Formula $n>N_{1}$
\end_inset

 menyiratkan 
\begin_inset Formula $\frac{|p_{n+1}-p|}{|p_{n}-p|^{\alpha}}>0.9\lambda$
\end_inset

.
 Terdapat pula 
\begin_inset Formula $N_{2}$
\end_inset

 sedemikian sehingga 
\begin_inset Formula $n>N_{2}$
\end_inset

 menyiratkan 
\begin_inset Formula ${\displaystyle |p_{n}-p|<\left(\frac{0.9\lambda}{M}\right)^{\frac{1}{1-\alpha}}}$
\end_inset

, sehingga 
\begin_inset Formula $|p_{n}-p|^{\alpha-1}>\frac{M}{0.9\lambda}$
\end_inset

.
 Dengan mengambil 
\begin_inset Formula $N=\max\{N_{1},N_{2}\}$
\end_inset

, kita memperoleh bahwa 
\begin_inset Formula $n>N$
\end_inset

 menyiratkan sekaligus 
\begin_inset Formula $\frac{|p_{n+1}-p|}{|p_{n}-p|^{\alpha}}>0.9\lambda$
\end_inset

 dan 
\begin_inset Formula $|p_{n}-p|^{\alpha-1}>\frac{M}{0.9\lambda}$
\end_inset

.
 Oleh karena itu, untuk 
\begin_inset Formula $n>N$
\end_inset

, berlaku 
\begin_inset Formula 
\begin{eqnarray*}
\frac{|p_{n+1}-p|}{|p_{n}-p|} & = & \frac{|p_{n+1}-p|}{|p_{n}-p|^{\alpha}}\cdot|p_{n}-p|^{\alpha-1}>0.9\lambda\cdot\frac{M}{0.9\lambda}=M.
\end{eqnarray*}

\end_inset

Dengan demikian, 
\begin_inset Formula $\lim_{n\to\infty}\frac{|p_{n+1}-p|}{|p_{n}-p|}$
\end_inset

 tidak ada.
 Ketika 
\begin_inset Formula $\alpha=1$
\end_inset

, haruslah 
\begin_inset Formula $\lambda\leq1$
\end_inset

 karena jika tidak, uji rasio menyiratkan bahwa 
\begin_inset Formula $\langle|p_{n}-p|\rangle$
\end_inset

 divergen dan, dengan demikian, 
\begin_inset Formula $\langle p_{n}\rangle$
\end_inset

 divergen.
 
\end_layout

