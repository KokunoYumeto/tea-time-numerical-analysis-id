\begin_inset CommandInset label
LatexCommand label
name "odeMoreSolutions"

\end_inset


\begin_inset Formula $\theta=ae^{2t/3}$
\end_inset


\begin_inset space \space{}
\end_inset

merupakan
\begin_inset space \space{}
\end_inset

suatu
\begin_inset space \space{}
\end_inset

solusi
\begin_inset space \space{}
\end_inset

dari 
\begin_inset Formula $3\ddot{\theta}-8\dot{\theta}+4\theta=0$
\end_inset

: 
\begin_inset Formula $\dot{\theta}=\frac{2}{3}ae^{2t/3}$
\end_inset

 dan 
\begin_inset Formula $\ddot{\theta}=\frac{4}{9}ae^{2t/3}$
\end_inset

 sehingga 
\begin_inset Formula 
\begin{eqnarray*}
3\ddot{\theta}-8\dot{\theta}+4\theta & = & 3\left(\frac{4}{9}ae^{2t/3}\right)-8\left(\frac{2}{3}ae^{2t/3}\right)+4\left(ae^{2t/3}\right)\\
 & = & \frac{4}{3}a(e^{2t/3})-\frac{16}{3}a(e^{2t/3})+\frac{12}{3}a(e^{2t/3})\\
 & = & \left(\frac{4}{3}a-\frac{16}{3}a+\frac{12}{3}a\right)e^{2t/3}\\
 & = & 0.
\end{eqnarray*}

\end_inset


\end_layout

\begin_layout Description
\begin_inset CommandInset label
LatexCommand label
name "odeEvenMoreSolutions"

\end_inset


\begin_inset Formula $\theta=ce^{2t}+ae^{2t/3}$
\end_inset


\begin_inset space \space{}
\end_inset

merupakan
\begin_inset space \space{}
\end_inset

suatu
\begin_inset space \space{}
\end_inset

solusi
\begin_inset space \space{}
\end_inset

dari
\begin_inset space \space{}
\end_inset


\begin_inset Formula $3\ddot{\theta}-8\dot{\theta}+4\theta=0$
\end_inset

: 
\begin_inset Formula $\dot{\theta}=2ce^{2t}+\frac{2}{3}ae^{2t/3}$
\end_inset

 dan 
\begin_inset Formula $\ddot{\theta}=4ce^{2t}+\frac{4}{9}ae^{2t/3}$
\end_inset

 sehingga 
\begin_inset Formula 
\begin{eqnarray*}
3\ddot{\theta}-8\dot{\theta}+4\theta & = & 3\left(4ce^{2t}+\frac{4}{9}ae^{2t/3}\right)-8\left(2ce^{2t}+\frac{2}{3}ae^{2t/3}\right)+4\left(ce^{2t}+ae^{2t/3}\right)\\
 & = & 12c(e^{2t})+\frac{4}{3}a(e^{2t/3})-16c(e^{2t})-\frac{16}{3}a(e^{2t/3})+4c(e^{2t})+\frac{12}{3}a(e^{2t/3})\\
 & = & (12c-16c+4c)e^{2t}+\left(\frac{4}{3}a-\frac{16}{3}a+\frac{12}{3}a\right)e^{2t/3}\\
 & = & 0.
\end{eqnarray*}

\end_inset


