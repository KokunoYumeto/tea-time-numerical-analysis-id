reference "eq:HermiteCubicForHumans"

\end_inset

 menghasilkan 
\begin_inset Formula $m=\frac{5+1}{1-0}=6$
\end_inset

 dan
\begin_inset Formula 
\[
x(t)=\frac{t-1}{-1}(-1)+\frac{t}{1}(5)+\frac{(t-1)^{2}t}{1}\left(3-6\right)+\frac{t^{2}(t-1)}{1}\left(-6\right).
\]

\end_inset

Persamaan 
\begin_inset CommandInset ref
