\begin_deeper
\begin_layout Proof
Pembuktian dilakukan dengan induksi terhadap 
\begin_inset Formula $j$
\end_inset

, dimulai dari 
\begin_inset Formula $j=1$
\end_inset

: Berdasarkan
\begin_inset Formula 
\[
\vec{B}_{1,i}(t)=(1-t)\vec{P}_{i}+(t)\vec{P}_{i+1},\qquad i=0,1,\ldots,n-1,
\]

\end_inset


, berlaku 
\begin_inset Formula $\vec{B}_{1,i}(0)=\vec{P}_{i}$
\end_inset

 dan 
\begin_inset Formula $B_{1,i}(1)=\vec{P}_{i+1}$
\end_inset

, sehingga 
\begin_inset Formula $\vec{B}_{1,i}$
\end_inset

 menghubungkan 
\begin_inset Formula $\vec{P}_{i}$
\end_inset

 dengan 
\begin_inset Formula $\vec{P}_{i+1}$
\end_inset

.
 Selain itu, 
\begin_inset Formula $\vec{B}_{1,i}(t)=\vec{P}_{i}+t(\vec{P}_{i+1}-\vec{P}_{i})$
\end_inset

, sehingga 
\begin_inset Formula $\vec{B}_{1,i}$
\end_inset

 merupakan polinom berderajat paling tinggi 1.
 Sekarang andaikan 
\begin_inset Formula $\vec{B}_{j,i}(t)$
\end_inset

 merupakan polinom berderajat paling tinggi 
\begin_inset Formula $j$
\end_inset

 yang menghubungkan 
\begin_inset Formula $\vec{P_{i}}$
\end_inset

 dengan 
\begin_inset Formula $\vec{P_{i+j}}$
\end_inset

 untuk suatu 
\begin_inset Formula $j\geq1$
\end_inset

 (dan semua 
\begin_inset Formula $i$
\end_inset

 yang berlaku).
 Berdasarkan definisi, 
\begin_inset Formula $\vec{B}_{j+1,i}(0)=\vec{B}_{j,i}(0)$
\end_inset

 dan 
\begin_inset Formula $\vec{B}_{j+1,i}(1)=\vec{B}_{j,i+1}(1)$
\end_inset

.
 Berdasarkan hipotesis induksi, 
\begin_inset Formula $\vec{B}_{j,i}(0)=\vec{P}_{i}$
\end_inset

 dan 
\begin_inset Formula $\vec{B}_{j,i+1}(1)=\vec{P}_{i+j+1}$
\end_inset

, sehingga 
\begin_inset Formula $\vec{B}_{j+1,i}$
\end_inset

 menghubungkan 
\begin_inset Formula $\vec{P}_{i}$
\end_inset

 dengan 
\begin_inset Formula $\vec{P}_{i+j+1}$
\end_inset

.
 Selain itu,
\begin_inset Formula 
\[
\vec{B}_{j+1,i}(t)=(1-t)\cdot\vec{B}_{j,i}(t)+(t)\cdot\vec{B}_{j,i+1}(t)
\]

\end_inset

berderajat paling tinggi 
\begin_inset Formula $j+1$
\end_inset

 karena 
\begin_inset Formula $\vec{B}_{j,i}(t)$
\end_inset

 dan 
\begin_inset Formula $\vec{B}_{j,i+1}(t)$
\end_inset

 masing-masing berderajat paling tinggi 
\begin_inset Formula $j$
\end_inset

 (berdasarkan hipotesis induksi).
 Dengan demikian, pembuktian selesai.
\end_layout

\end_deeper
